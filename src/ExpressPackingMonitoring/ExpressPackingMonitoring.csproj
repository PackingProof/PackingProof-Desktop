  <!-- 排除不需要的 OpenCV 内置 ffmpeg（已使用独立 ffmpeg.exe 管道录制） -->
  <ItemGroup>
    <Content Remove="runtimes\**\opencv_videoio_ffmpeg*" />
    <None Remove="runtimes\**\opencv_videoio_ffmpeg*" />
  </ItemGroup>
  <Target Name="RemoveUnusedDlls" AfterTargets="ResolveReferences">
    <ItemGroup>
      <!-- OpenCV 内置 ffmpeg -->
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('opencv_videoio_ffmpeg'))" />
      <!-- Kokoro native runtime is optional and should not be bundled by default. -->
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'onnxruntime'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'sherpa-onnx-c-api'" />
    </ItemGroup>
  </Target>

  <!-- Publish 时同样排除 -->
  <Target Name="RemoveUnusedFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('opencv_videoio_ffmpeg'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'onnxruntime'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'sherpa-onnx-c-api'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' Or '%(Extension)' == '.xml' Or '%(Extension)' == '.lib'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(RelativePath)').StartsWith('libvlc\win-x86\'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(RelativePath)').Contains('\include\'))" />
    </ItemGroup>
  </Target>

  <!-- ffmpeg.exe 作为独立进程保留，但发布到 tools 子目录，避免根目录混杂依赖文件。
       开发构建优先复制钉死的 FFmpeg 基线缓存；缓存不存在时回退到项目根目录的 ffmpeg.exe。 -->
  <ItemGroup>
    <Content Include="$(FFmpegBaselineExecutable)" Condition="Exists('$(FFmpegBaselineExecutable)')">
      <TargetPath>tools\ffmpeg.exe</TargetPath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="ffmpeg.exe" Condition="!Exists('$(FFmpegBaselineExecutable)') And Exists('ffmpeg.exe')">
      <TargetPath>tools\ffmpeg.exe</TargetPath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <Target Name="IncludeLibVlcFilesForPublish" AfterTargets="ComputeFilesToPublish" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PropertyGroup>
      <VlcPluginRoot>$(NuGetPackageRoot)videolan.libvlc.windows\3.0.21\build\x64\plugins\</VlcPluginRoot>
    </PropertyGroup>
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(RelativePath)').StartsWith('libvlc\'))" />

      <LibVlcX64Dll Include="$(NuGetPackageRoot)videolan.libvlc.windows\3.0.21\build\x64\libvlc.dll" />
      <LibVlcX64Dll Include="$(NuGetPackageRoot)videolan.libvlc.windows\3.0.21\build\x64\libvlccore.dll" />
      <!-- LibVLC 自带 250 多个插件，占包内约 32 MB，而回放只用到本地 mp4/mkv：
           H.264/HEVC/AV1 解码、AAC/MP3 等常见音轨、Direct3D 输出和 Windows 音频输出。
           这里改成显式白名单，去掉网络流、字幕渲染、VP8/VP9、VR、可视化等无关插件。
           新增回放格式时必须同步补充对应插件并跑多格式回放回归。 -->
      <LibVlcX64Plugin Include="$(VlcPluginRoot)codec\libavcodec_plugin.dll;$(VlcPluginRoot)codec\libdav1d_plugin.dll;$(VlcPluginRoot)codec\libd3d11va_plugin.dll;$(VlcPluginRoot)codec\libdxva2_plugin.dll;$(VlcPluginRoot)codec\libmft_plugin.dll;$(VlcPluginRoot)codec\librawvideo_plugin.dll;$(VlcPluginRoot)codec\liblpcm_plugin.dll;$(VlcPluginRoot)codec\libg711_plugin.dll;$(VlcPluginRoot)codec\libadpcm_plugin.dll;$(VlcPluginRoot)codec\libvorbis_plugin.dll;$(VlcPluginRoot)codec\libopus_plugin.dll;$(VlcPluginRoot)codec\libflac_plugin.dll;$(VlcPluginRoot)codec\libmpg123_plugin.dll;$(VlcPluginRoot)codec\libtheora_plugin.dll">
        <PluginTargetDir>codec</PluginTargetDir>
      </LibVlcX64Plugin>
      <LibVlcX64Plugin Include="$(VlcPluginRoot)demux\libmkv_plugin.dll;$(VlcPluginRoot)demux\libmp4_plugin.dll;$(VlcPluginRoot)demux\libh26x_plugin.dll;$(VlcPluginRoot)demux\libavi_plugin.dll;$(VlcPluginRoot)demux\libplaylist_plugin.dll;$(VlcPluginRoot)demux\libsubtitle_plugin.dll">
        <PluginTargetDir>demux</PluginTargetDir>
      </LibVlcX64Plugin>
      <LibVlcX64Plugin Include="$(VlcPluginRoot)packetizer\libpacketizer_h264_plugin.dll;$(VlcPluginRoot)packetizer\libpacketizer_hevc_plugin.dll;$(VlcPluginRoot)packetizer\libpacketizer_mpeg4audio_plugin.dll;$(VlcPluginRoot)packetizer\libpacketizer_av1_plugin.dll;$(VlcPluginRoot)packetizer\libpacketizer_mpeg4video_plugin.dll;$(VlcPluginRoot)packetizer\libpacketizer_mpegvideo_plugin.dll">
        <PluginTargetDir>packetizer</PluginTargetDir>
      </LibVlcX64Plugin>
      <LibVlcX64Plugin Include="$(VlcPluginRoot)video_output\libdirect3d11_plugin.dll;$(VlcPluginRoot)video_output\libdirect3d9_plugin.dll;$(VlcPluginRoot)video_output\libwingdi_plugin.dll;$(VlcPluginRoot)video_output\libdirectdraw_plugin.dll;$(VlcPluginRoot)video_output\libvdummy_plugin.dll">
        <PluginTargetDir>video_output</PluginTargetDir>
      </LibVlcX64Plugin>
      <LibVlcX64Plugin Include="$(VlcPluginRoot)video_chroma\*.dll">
        <PluginTargetDir>video_chroma</PluginTargetDir>
      </LibVlcX64Plugin>
      <LibVlcX64Plugin Include="$(VlcPluginRoot)audio_output\libmmdevice_plugin.dll;$(VlcPluginRoot)audio_output\libdirectsound_plugin.dll;$(VlcPluginRoot)audio_output\libwaveout_plugin.dll;$(VlcPluginRoot)audio_output\libwasapi_plugin.dll;$(VlcPluginRoot)audio_output\libadummy_plugin.dll">
        <PluginTargetDir>audio_output</PluginTargetDir>
      </LibVlcX64Plugin>
      <LibVlcX64Plugin Include="$(VlcPluginRoot)audio_filter\libaudio_format_plugin.dll;$(VlcPluginRoot)audio_filter\libscaletempo_plugin.dll;$(VlcPluginRoot)audio_filter\libsimple_channel_mixer_plugin.dll;$(VlcPluginRoot)audio_filter\libtrivial_channel_mixer_plugin.dll;$(VlcPluginRoot)audio_filter\libugly_resampler_plugin.dll;$(VlcPluginRoot)audio_filter\libspeex_resampler_plugin.dll">
        <PluginTargetDir>audio_filter</PluginTargetDir>
      </LibVlcX64Plugin>
      <LibVlcX64Plugin Include="$(VlcPluginRoot)audio_mixer\*.dll">
        <PluginTargetDir>audio_mixer</PluginTargetDir>
      </LibVlcX64Plugin>
      <LibVlcX64Plugin Include="$(VlcPluginRoot)meta_engine\libtaglib_plugin.dll">
        <PluginTargetDir>meta_engine</PluginTargetDir>
      </LibVlcX64Plugin>
      <LibVlcX64Plugin Include="$(VlcPluginRoot)stream_filter\libprefetch_plugin.dll;$(VlcPluginRoot)stream_filter\libcache_read_plugin.dll;$(VlcPluginRoot)stream_filter\libinflate_plugin.dll">
        <PluginTargetDir>stream_filter</PluginTargetDir>
      </LibVlcX64Plugin>
      <LibVlcX64Plugin Include="$(VlcPluginRoot)d3d11\*.dll">
        <PluginTargetDir>d3d11</PluginTargetDir>
      </LibVlcX64Plugin>
      <LibVlcX64Plugin Include="$(VlcPluginRoot)d3d9\*.dll">
        <PluginTargetDir>d3d9</PluginTargetDir>
      </LibVlcX64Plugin>
      <LibVlcX64Plugin Include="$(VlcPluginRoot)logger\*.dll">
        <PluginTargetDir>logger</PluginTargetDir>
      </LibVlcX64Plugin>
      <LibVlcX64AccessPlugin Include="$(NuGetPackageRoot)videolan.libvlc.windows\3.0.21\build\x64\plugins\access\libfilesystem_plugin.dll" />
      <LibVlcX64AccessPlugin Include="$(NuGetPackageRoot)videolan.libvlc.windows\3.0.21\build\x64\plugins\access\libidummy_plugin.dll" />
      <LibVlcX64AccessPlugin Include="$(NuGetPackageRoot)videolan.libvlc.windows\3.0.21\build\x64\plugins\access\libattachment_plugin.dll" />
      <LibVlcX64AccessPlugin Include="$(NuGetPackageRoot)videolan.libvlc.windows\3.0.21\build\x64\plugins\access\libimem_plugin.dll" />
      <LibVlcX64AccessPlugin Include="$(NuGetPackageRoot)videolan.libvlc.windows\3.0.21\build\x64\plugins\access\libaccess_concat_plugin.dll" />

      <!-- 移除运行时不需要的诊断/设计时程序集，进一步压缩发布体积：
           WinForms 设计时程序集。ReachFramework 是 WPF 打印（指令条码打印）的运行时依赖，必须保留。 -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('System.Windows.Forms.Design'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'System.Design'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'System.Drawing.Design'" />
      <!-- 托盘已改用 Shell_NotifyIcon；自包含运行时不应再带 WinForms。 -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'System.Windows.Forms'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'System.Windows.Forms.Primitives'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'Microsoft.VisualBasic.Forms'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'NAudio.WinForms'" />

      <ResolvedFileToPublish Include="@(LibVlcX64Dll)">
        <RelativePath>libvlc\win-x64\%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="@(LibVlcX64Plugin)">
        <RelativePath>libvlc\win-x64\plugins\%(LibVlcX64Plugin.PluginTargetDir)\%(LibVlcX64Plugin.Filename)%(LibVlcX64Plugin.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="@(LibVlcX64AccessPlugin)">
        <RelativePath>libvlc\win-x64\plugins\access\%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="CopyWinTtsRuntimeToBuildOutput" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <WinTtsProjectPath>$(MSBuildProjectDirectory)\..\ExpressPackingMonitoring.WinTts\ExpressPackingMonitoring.WinTts.csproj</WinTtsProjectPath>
      <WinTtsPublishDirectory>$(IntermediateOutputPath)wintts-runtime</WinTtsPublishDirectory>
      <WinTtsArtifactsArgument Condition="'$(ArtifactsPath)' != ''">--artifacts-path "$(ArtifactsPath)"</WinTtsArtifactsArgument>
    </PropertyGroup>
    <Exec Command="dotnet publish &quot;$(WinTtsProjectPath)&quot; -c &quot;$(Configuration)&quot; --no-restore --nologo $(WinTtsArtifactsArgument) -o &quot;$(WinTtsPublishDirectory)&quot;" />
    <ItemGroup>
      <WinTtsRuntimeFile Include="$(WinTtsPublishDirectory)\ExpressPackingMonitoring.WinTts.dll" />
      <WinTtsRuntimeFile Include="$(WinTtsPublishDirectory)\Microsoft.Windows.SDK.NET.dll" />
      <WinTtsRuntimeFile Include="$(WinTtsPublishDirectory)\WinRT.Runtime.dll" />
    </ItemGroup>
    <Error Condition="!Exists('%(WinTtsRuntimeFile.Identity)')" Text="WinTts runtime output missing: %(WinTtsRuntimeFile.Identity)" />
    <Copy SourceFiles="@(WinTtsRuntimeFile)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
