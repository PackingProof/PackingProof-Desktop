<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <!--
      开发构建与发布都不再自包含：运行时统一放在包根的 runtime\，由启动器通过 DOTNET_ROOT 复用，
      增量包也不会再因为运行时漂移而膨胀（这正是当初这里钉死 RuntimeFrameworkVersion 的原因，
      现在由共享运行时布局根治）。自包含只用于跨机用的分发形态，由发布脚本显式传参。
    -->
    <SelfContained>false</SelfContained>
    <UseRidGraph>true</UseRidGraph>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Media Foundation 采集路径要按 BT.709 逐像素解 YUY2/NV12（MfFrameConverter），
         这条路径每秒 60 帧 1080p，托管数组的边界检查开销占比过高。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);NU1701;MVVMTK0045;MSB3277</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin_publish_tmp\**;obj_publish_tmp\**;publish-test\**;publish-size-*\**;bin\Release\publish\**</DefaultItemExcludes>
    
    <!-- 主应用保持目录发布，保留压缩包体积优势；清爽根目录由发布脚本和启动器实现。 -->
    <PublishSingleFile>false</PublishSingleFile>
    <!-- 原生库保持可独立加载，优先保证 OpenCV/SQLite/LibVLC 等运行稳定性。 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 开发构建使用与发布一致的 FFmpeg 基线（tools/ffmpeg-baseline.json），避免开发/发布能力漂移。 -->
    <FFmpegBaselineVersion>4.4.1-minimal</FFmpegBaselineVersion>
    <FFmpegBaselineExecutable>..\..\package\dependency-cache\ffmpeg\$(FFmpegBaselineVersion)\ffmpeg.exe</FFmpegBaselineExecutable>
    <SatelliteResourceLanguages>en-US;zh-Hans;ja-JP</SatelliteResourceLanguages>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
