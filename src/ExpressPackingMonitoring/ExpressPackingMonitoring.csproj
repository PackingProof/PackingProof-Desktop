    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ExpressPackingMonitoring.EncodingIntegrationTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

