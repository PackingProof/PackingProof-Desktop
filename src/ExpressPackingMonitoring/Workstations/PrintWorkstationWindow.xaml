<Window x:Class="ExpressPackingMonitoring.PrintWorkstationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ExpressPackingMonitoring.UI.Controls"
        xmlns:loc="clr-namespace:ExpressPackingMonitoring.Localization"
        Title="Storage Host"
        Width="760"
        MinWidth="760"
        MaxHeight="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style x:Key="IconActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
        <Style x:Key="SummaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="HeaderComputerNameText"
                                   FontSize="28"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="HeaderComputerIpText"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="10,4,0,0"/>
                    </StackPanel>
                    <TextBlock Margin="0,7,0,0"
                               Text="备份主机 · 接收并长期保存手机或其他电脑的录像，支持备份到 NAS／网络共享文件夹"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <Button x:Name="SwitchPurposeButton"
                        Grid.Column="1"
                        Height="38"
                        Padding="14,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="SwitchWorkstation_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource FluentArrowSwapIcon}"
                              Width="15" Height="15" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock x:Name="SwitchPurposeButtonText"
                                   Text="切换用途"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="284"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <controls:StatusCard x:Name="MobileBackupStatusCard"
                                             CardIcon="{StaticResource FluentWifiIcon}"
                                             CardTitle="手机/电脑备份"
                                             DeviceItemsSource="{Binding MobileBackupDeviceStatuses, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Cursor="Hand"
                                             Focusable="True"
                                             ToolTip="{loc:Localized 打开设备与传输管理}"
                                             AutomationProperties.Name="{loc:Localized 打开设备与传输管理}"
                                             PreviewMouseLeftButtonUp="MobileBackupStatusCard_PreviewMouseLeftButtonUp"
                                             PreviewKeyDown="MobileBackupStatusCard_PreviewKeyDown"/>
                        <Button x:Name="RepairLanButton"
                                Height="28"
                                Margin="0,8,0,0"
                                Padding="9,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="RepairLan_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource FluentWarningIcon}"
                                      Width="13" Height="13" Stretch="Uniform"
                                      Fill="{DynamicResource AccentOrange}"/>
                                <TextBlock Text="修复局域网" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <controls:StatusCard x:Name="ArchiveBackupStatusCard"
                                             Margin="0,6,0,0"
                                             CardIcon="{StaticResource FluentDatabaseIcon}"
                                             CardTitle="录像备份"/>
                        <controls:StatusCard x:Name="UserscriptStatusCard"
                                             Margin="0,6,0,0"
                                             CardIcon="{StaticResource FluentIntegrationIcon}"
                                             CardTitle="订单联动"/>
                    </StackPanel>

                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Button x:Name="ConnectPhoneButton"
                                Grid.Column="0"
                                Style="{StaticResource IconActionButtonStyle}"
                                Click="ConnectPhone_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource FluentWifiIcon}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="连接手机/电脑" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenWebButton"
                                Grid.Column="2"
                                Style="{StaticResource IconActionButtonStyle}"
                                Click="OpenWeb_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource FluentPlayIcon}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="网页回放" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="InstallUserscriptButton"
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource IconActionButtonStyle}"
                                ToolTip="安装或更新快递助手订单联动脚本"
                                Click="InstallTool_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource FluentIntegrationIcon}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock x:Name="InstallUserscriptButtonText"
                                           Text="安装订单联动"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SendTestOrderButton"
                                Grid.Row="2"
                                Grid.Column="2"
                                Style="{StaticResource IconActionButtonStyle}"
                                ToolTip="向当前在线的全部录像设备发送测试订单"
                                Click="SendTestOrder_Click"
                                IsEnabled="False">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource FluentBroadcastIcon}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock x:Name="SendTestOrderButtonText"
                                           Text="发送测试订单"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BackupStatsButton"
                            Style="{StaticResource StatsLinkButtonStyle}"
                            Margin="0,0,10,0"
                            Click="OpenStatistics_Click"
                            PreviewMouseLeftButtonUp="BackupStats_MouseLeftButtonUp"
                            ToolTip="{loc:Localized 数据统计}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,0,28,0">
                                <TextBlock Text="{loc:Localized 今日}"
                                           FontSize="15"
                                           Style="{StaticResource StatsLinkLabelTextStyle}"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"
                                           Margin="0,0,7,0"/>
                                <TextBlock x:Name="TodayBackupCountTextBlock"
                                           Text="0"
                                           FontSize="27"
                                           FontWeight="Black"
                                           Style="{StaticResource StatsLinkValueTextStyle}"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"/>
                                <TextBlock Text="{loc:Localized 今日数量单位}"
                                           FontSize="15"
                                           Style="{StaticResource StatsLinkValueTextStyle}"
                                           Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Localized 累计}"
                                           FontSize="15"
                                           Style="{StaticResource StatsLinkLabelTextStyle}"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"
                                           Margin="0,0,7,0"/>
                                <TextBlock x:Name="TotalBackupCountTextBlock"
                                           Text="0"
                                           FontSize="27"
                                           FontWeight="Black"
                                           Style="{StaticResource StatsLinkValueTextStyle}"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"/>
                                <TextBlock Text="{loc:Localized 今日数量单位}"
                                           FontSize="15"
                                           Style="{StaticResource StatsLinkValueTextStyle}"
                                           Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ExtensionButton"
                                Style="{StaticResource SummaryButtonStyle}"
                                Margin="0,0,10,0"
                                Click="OpenExtension_Click"
                                ToolTip="{loc:Localized 扩展市场}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource FluentIntegrationIcon}"
                                      Width="17" Height="17" Stretch="Uniform"
                                      Fill="{DynamicResource AccentBlue}"/>
                                <TextBlock Text="{loc:Localized 扩展}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PlaybackButton"
                                Style="{StaticResource SummaryButtonStyle}"
                                Margin="0,0,10,0"
                                Click="OpenPlayback_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource FluentVideoIcon}"
                                      Width="17" Height="17" Stretch="Uniform"
                                      Fill="{DynamicResource AccentBlue}"/>
                                <TextBlock Text="回放" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsButton"
                                Style="{StaticResource SummaryButtonStyle}"
                                Click="OpenSettings_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource FluentSettingsIcon}"
                                      Width="17" Height="17" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="设置" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>
        </ScrollViewer>

        <Border Background="{DynamicResource ToastBackground}"
                CornerRadius="8"
                Padding="24,13"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="620"
                IsHitTestVisible="False"
                Panel.ZIndex="1000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Setter Property="Opacity" Value="0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastState.IsToastVisible, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <Path x:Name="ToastIconPath"
                      Width="18"
                      Height="18"
                      Margin="0,0,9,0"
                      Stretch="Uniform"
                      Fill="{StaticResource TextOnAccent}"
                      VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ToastState.ToastMessage, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="{StaticResource TextOnAccent}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
