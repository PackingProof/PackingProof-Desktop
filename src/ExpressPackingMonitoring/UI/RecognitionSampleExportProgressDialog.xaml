<Window x:Class="ExpressPackingMonitoring.UI.RecognitionSampleExportProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ExpressPackingMonitoring.UI.Controls"
        xmlns:loc="clr-namespace:ExpressPackingMonitoring.Localization"
        Title="{loc:Localized 正在导出样本包}"
        SizeToContent="Height"
        Width="520"
        MaxHeight="620"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource TransparentBrush}"
        Foreground="{DynamicResource TextPrimary}"
        ContentRendered="Window_ContentRendered"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">
    <Border Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource BorderStrong}"
            BorderThickness="2"
            CornerRadius="14"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="38"
                        Height="38"
                        CornerRadius="12"
                        Background="{DynamicResource ControlBackground}">
                    <Path Data="{StaticResource FluentSaveIcon}"
                          Width="20"
                          Height="20"
                          Stretch="Uniform"
                          Fill="{DynamicResource AccentBlue}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Localized 正在导出样本包}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,18,0,0"
                    Padding="14"
                    CornerRadius="10"
                    Background="{DynamicResource ControlBackground}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProgressSummaryText"
                                   Text="{loc:Localized 正在准备样本}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="ElapsedTimeText"
                                   Grid.Column="1"
                                   Margin="16,0,0,0"
                                   HorizontalAlignment="Right"
                                   Text="{loc:Localized 已用时 0 秒}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </Grid>
                    <controls:SmoothProgressBar x:Name="ExportProgressBar"
                                                Style="{StaticResource RoundedSmoothProgressBar}"
                                                Height="6"
                                                Margin="0,12,0,0"
                                                Minimum="0"
                                                Maximum="100"
                                                AnimationDuration="200"
                                                Background="{DynamicResource BorderStrong}"
                                                Foreground="{DynamicResource AccentBlue}"
                                                IsIndeterminate="True"/>
                </StackPanel>
            </Border>

            <Button x:Name="CancelExportButton"
                    Grid.Row="2"
                    HorizontalAlignment="Right"
                    Margin="0,22,0,0"
                    MinWidth="110"
                    Content="{loc:Localized 取消}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="CancelExportButton_Click"
                    AutomationProperties.Name="{loc:Localized 取消}"/>
        </Grid>
    </Border>
</Window>
