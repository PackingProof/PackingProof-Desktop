<Window x:Class="ExpressPackingMonitoring.UI.TransferManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ExpressPackingMonitoring.UI.Controls"
        xmlns:loc="clr-namespace:ExpressPackingMonitoring.Localization"
        Title="{loc:Localized 设备与传输}"
        Width="480"
        Height="400"
        MinWidth="420"
        MaxWidth="720"
        MinHeight="320"
        MaxHeight="720"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="/app.ico"
        Background="{DynamicResource PanelBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="CompactRetryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinWidth" Value="46"/>
            <Setter Property="Height" Value="27"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TransferInfoText}"/>
        </Style>
        <Style x:Key="CompactRemoveButton" TargetType="Button" BasedOn="{StaticResource DeleteButtonStyle}">
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryStrong}"/>
        </Style>
        <Style x:Key="AttentionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TransferAttentionText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="TransferRowStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AttentionRowStyle"
               TargetType="Border"
               BasedOn="{StaticResource TransferRowStyle}">
            <Setter Property="Background" Value="{DynamicResource TransferAttentionSurface}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BadgeReturnBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FailureRowStyle"
               TargetType="Border"
               BasedOn="{StaticResource TransferRowStyle}">
            <Setter Property="Background" Value="{DynamicResource TransferFailureSurface}"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource PanelBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="14,10,10,8"
                    BorderBrush="{DynamicResource BorderLight}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding TodaySummaryLabel}"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryStrong}"/>
                        <TextBlock Text="{Binding TodayReceivedCountText}"
                                   Margin="6,0,2,0"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{loc:Localized 今日数量单位}"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryStrong}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SummaryText}"
                               Grid.Column="1"
                               Margin="14,0,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               TextAlignment="Right"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TransferAttentionText}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAttentionSummary}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Padding="14,8,14,8"
                    BorderBrush="{DynamicResource BorderLight}"
                    BorderThickness="0,0,0,1"
                    Visibility="{Binding HasDetailSummary, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Border Margin="0,7,0,0"
                            Padding="8,5"
                            CornerRadius="6"
                            Background="{DynamicResource ControlBackground}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StopReasonText}"
                                       Margin="0,0,10,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TransferAttentionText}"/>
                            <Button x:Name="CheckUpdateButton"
                                    Grid.Column="1"
                                    Content="{loc:Localized 检查更新}"
                                    Click="CheckUpdate_Click"
                                    Style="{StaticResource CompactRetryButton}"
                                    Visibility="{Binding ShowCheckUpdateButton, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2"
                          MaxHeight="500"
                          Padding="12,8,12,8"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <Grid>
                    <StackPanel Visibility="{Binding IsHostMode, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding AttentionDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource AttentionRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="{Binding DataContext.DeviceNameColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <ColumnDefinition Width="{Binding DataContext.TodayColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <ColumnDefinition Width="{Binding DataContext.ActivityColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <ColumnDefinition Width="{Binding DataContext.AttentionColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="7"
                                                     Height="7"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Center"
                                                     Fill="{DynamicResource TextMuted}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource TextMuted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource AccentGreen}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayName}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayName}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Localized 今日}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryStrong}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TodayCountText}"
                                                           Margin="4,0,0,0"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding ActivityText}"
                                                       Margin="8,0,0,0"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryStrong}"/>
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding AttentionText}"
                                                       Margin="8,0,0,0"
                                                       Style="{StaticResource AttentionText}"
                                                       TextAlignment="Left"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="6"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource CompactRemoveButton}"
                                                    Content="{loc:Localized 解绑}"
                                                    ToolTip="{loc:Localized 解绑从机}"
                                                    AutomationProperties.Name="{loc:Localized 解绑从机}"
                                                    Click="RemoveDevice_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Margin="0,1,0,5"
                                Padding="9,6"
                                Command="{Binding ToggleNormalDevicesCommand}"
                                Background="{DynamicResource ControlBackground}"
                                BorderBrush="{DynamicResource BorderLight}"
                                BorderThickness="1"
                                Cursor="Hand"
                                Visibility="{Binding HasNormalDevices, Converter={StaticResource BoolToVisibility}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="NormalDevicesHeaderSurface"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="NormalDevicesHeaderSurface"
                                                    Property="Background"
                                                    Value="{DynamicResource ControlBackgroundHover}"/>
                                            <Setter TargetName="NormalDevicesHeaderSurface"
                                                    Property="BorderBrush"
                                                    Value="{DynamicResource BorderStrong}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="NormalDevicesHeaderSurface"
                                                    Property="Opacity"
                                                    Value="0.82"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding NormalDevicesHeader}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryStrong}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding NormalDevicesToggleText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TransferInfoText}"/>
                                    <Path Width="9"
                                          Height="6"
                                          Margin="5,0,0,0"
                                          Data="M 1 1 L 5 5 L 9 1"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource TransferInfoText}"
                                          StrokeThickness="1.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0" CenterX="4.5" CenterY="3"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNormalDevicesExpanded}" Value="False">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="180" CenterX="4.5" CenterY="3"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <ItemsControl ItemsSource="{Binding NormalDevices}"
                                      Visibility="{Binding IsNormalDevicesExpanded, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TransferRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="{Binding DataContext.DeviceNameColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <ColumnDefinition Width="{Binding DataContext.TodayColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <ColumnDefinition Width="{Binding DataContext.ActivityColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <ColumnDefinition Width="{Binding DataContext.AttentionColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="7"
                                                     Height="7"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Center"
                                                     Fill="{DynamicResource AccentGreen}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayName}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayName}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Localized 今日}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryStrong}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TodayCountText}"
                                                           Margin="4,0,0,0"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding ActivityText}"
                                                       Margin="8,0,0,0"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryStrong}"/>
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding AttentionText}"
                                                       Margin="8,0,0,0"
                                                       Style="{StaticResource AttentionText}"
                                                       TextAlignment="Left"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="6"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource CompactRemoveButton}"
                                                    Content="{loc:Localized 解绑}"
                                                    ToolTip="{loc:Localized 解绑从机}"
                                                    AutomationProperties.Name="{loc:Localized 解绑从机}"
                                                    Click="RemoveDevice_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding EmptyText}"
                                   Margin="8,22"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryStrong}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasHostDevices}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHostMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ItemsControl ItemsSource="{Binding FailureItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource FailureRowStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Reason}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       MaxHeight="32"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TransferAttentionText}"
                                                       Visibility="{Binding HasReason, Converter={StaticResource BoolToVisibility}}"/>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding SummaryText}"
                                                       Margin="0,3,10,0"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondaryStrong}"/>
                                            <Button Grid.Column="1"
                                                    Grid.RowSpan="2"
                                                    Style="{StaticResource CompactRetryButton}"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Content="{loc:Localized 重试}"
                                                    Command="{Binding DataContext.RetryTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{loc:Localized 重试上传}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding FailureOverflowText}"
                                   Margin="2,0,0,6"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryStrong}"
                                   Visibility="{Binding HasFailureOverflow, Converter={StaticResource BoolToVisibility}}"/>

                        <Grid Height="54"
                              Margin="0,3,0,5">
                            <Border Padding="9,7"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    Visibility="{Binding HasUploadSlot, Converter={StaticResource BoolToVisibility}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UploadSlot.IsPaused}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource TransferAttentionSurface}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource TransferAttentionText}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding UploadSlot.StatusText}"
                                           FontSize="12"
                                           FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TransferInfoText}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UploadSlot.IsPaused}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TransferAttentionText}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding UploadSlot.ProgressText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TransferInfoText}"/>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding UploadSlot.SummaryText}"
                                           Margin="0,3,10,0"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryStrong}"/>
                                <controls:SmoothProgressBar x:Name="CurrentUploadProgress"
                                                            Grid.Row="1"
                                                            Grid.Column="1"
                                                            Width="120"
                                                            Height="6"
                                                            Margin="4,6,0,0"
                                                            Style="{StaticResource RoundedSmoothProgressBar}"
                                                            Minimum="0"
                                                            Maximum="100"
                                                            Value="{Binding UploadSlot.Progress}"
                                                            Foreground="{DynamicResource AccentBlue}"
                                                            Background="{DynamicResource BorderStrong}"
                                                            BorderThickness="0"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding RemainingUploadText}"
                                   Margin="2,1,0,4"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryStrong}"
                                   Visibility="{Binding HasRemainingUpload, Converter={StaticResource BoolToVisibility}}"/>

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="3"
                    Padding="12,8"
                    BorderBrush="{DynamicResource BorderLight}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding FooterText}"
                               Margin="2,0,10,0"
                               FontSize="10.5"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryStrong}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="{loc:Localized 全部重试}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="30"
                                Margin="0,0,8,0"
                                Command="{Binding RetryAllCommand}"
                                Visibility="{Binding HasFailureRows, Converter={StaticResource BoolToVisibility}}"/>
                        <Button Content="{Binding UploadPauseButtonText}"
                                Height="30"
                                Padding="12,0"
                                Command="{Binding ToggleUploadPauseCommand}"
                                Visibility="{Binding IsUploadPauseVisible, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="{Binding UploadPauseButtonText}">
                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUploadPaused}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentRed}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentRed}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextOnAccent}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
    </Grid>
</Window>
