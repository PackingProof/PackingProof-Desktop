<Window x:Class="ExpressPackingMonitoring.UI.PlaybackScreenshotDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ExpressPackingMonitoring.Localization"
        xmlns:ui="clr-namespace:ExpressPackingMonitoring.UI"
        Title="{loc:Localized 截图保存}"
        Width="380"
        MinWidth="380"
        SizeToContent="Height"
        MaxHeight="620"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource TransparentBrush}"
        Foreground="{DynamicResource TextPrimary}"
        KeyDown="Window_KeyDown">
    <Border Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource BorderStrong}"
            BorderThickness="2"
            CornerRadius="14"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="38"
                        Height="38"
                        CornerRadius="12"
                        Background="{DynamicResource AccentBlue}">
                    <Path Data="{StaticResource FluentPhotoCameraIcon}"
                          Width="20"
                          Height="20"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="{StaticResource TextOnAccent}"/>
                </Border>
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"
                           Text="{loc:Localized 截图保存}"
                           Foreground="{DynamicResource TextPrimary}"/>
            </Grid>

            <Border x:Name="PreviewFrame"
                    Grid.Row="1"
                    Margin="0,18,0,0"
                    MaxHeight="250"
                    HorizontalAlignment="Center"
                    CornerRadius="10"
                    Background="{StaticResource TransparentBrush}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="1">
                <Grid ui:RoundedClip.Radius="9" ClipToBounds="True">
                    <Image x:Name="PreviewImage"
                           Stretch="Fill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>

            <WrapPanel Grid.Row="2"
                       Margin="0,22,0,0"
                       HorizontalAlignment="Right">
                <Button x:Name="CopyButton"
                        MinWidth="112"
                        Content="{loc:Localized 复制到剪贴板}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,10,0"
                        Click="CopyButton_Click"/>
                <Button x:Name="SaveButton"
                        MinWidth="96"
                        Content="{loc:Localized 另存为}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,10,0"
                        Click="SaveButton_Click"/>
                <Button x:Name="CancelButton"
                        MinWidth="82"
                        Content="{loc:Localized 取消}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CancelButton_Click"/>
            </WrapPanel>
        </Grid>
    </Border>
</Window>
