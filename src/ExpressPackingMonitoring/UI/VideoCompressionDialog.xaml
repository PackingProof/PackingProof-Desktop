<Window x:Class="ExpressPackingMonitoring.UI.VideoCompressionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ExpressPackingMonitoring.UI.Controls"
        xmlns:loc="clr-namespace:ExpressPackingMonitoring.Localization"
        Title="{loc:Localized 导出压缩版本}"
        Width="620"
        Height="500"
        MinWidth="540"
        MinHeight="480"
        MaxWidth="760"
        MaxHeight="760"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="/app.ico"
        Background="{DynamicResource PanelBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style x:Key="SummaryValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="PresetButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondarySmallButtonStyle}">
            <Setter Property="MinWidth" Value="54"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style x:Key="PresetButtonActiveStyle"
               TargetType="Button"
               BasedOn="{StaticResource PresetButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Foreground" Value="{StaticResource TextOnAccent}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="DialogLayout"
          Margin="22"
          Background="{DynamicResource PanelBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="40"
                    Height="40"
                    CornerRadius="12"
                    Background="{DynamicResource AccentBlue}">
                <Path Data="{StaticResource FluentSaveIcon}"
                      Width="20"
                      Height="20"
                      Stretch="Uniform"
                      Fill="{StaticResource TextOnAccent}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="DialogTitleText"
                           Text="{loc:Localized 导出压缩版本}"
                           FontSize="19"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="DialogSubtitleText"
                           Margin="0,3,0,0"
                           Text="{loc:Localized 生成较小的新文件，不修改原录像}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Margin="0,18,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Padding="14"
                        CornerRadius="9"
                        Background="{DynamicResource ControlBackground}"
                        BorderBrush="{DynamicResource BorderDefault}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="{loc:Localized 单号}" Style="{StaticResource SummaryLabelStyle}"/>
                            <TextBlock x:Name="OrderText" Style="{StaticResource SummaryValueStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="{loc:Localized 原始大小}" Style="{StaticResource SummaryLabelStyle}"/>
                            <TextBlock x:Name="OriginalSizeText" Style="{StaticResource SummaryValueStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="{loc:Localized 录制时长}" Style="{StaticResource SummaryLabelStyle}"/>
                            <TextBlock x:Name="DurationText" Style="{StaticResource SummaryValueStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="{loc:Localized 当前编码}" Style="{StaticResource SummaryLabelStyle}"/>
                            <TextBlock x:Name="SourceCodecText" Style="{StaticResource SummaryValueStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="ConfigurationPanel" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Localized 编码方式}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <ComboBox x:Name="CodecModeBox"
                                  Grid.Column="1"
                                  Height="36"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="DisplayName"
                                  Cursor="Hand"
                                  SelectionChanged="CodecModeBox_SelectionChanged">
                        </ComboBox>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Localized 目标大小}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <Slider x:Name="TargetSizeSlider"
                                Grid.Column="1"
                                Margin="0,0,12,0"
                                Style="{StaticResource AccentSliderStyle}"
                                Minimum="1"
                                TickFrequency="0.1"
                                IsSnapToTickEnabled="True"
                                SmallChange="0.1"
                                LargeChange="10"
                                ValueChanged="TargetSizeSlider_ValueChanged"
                                AutomationProperties.Name="{loc:Localized 目标大小}"/>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button x:Name="TargetPreset30Button"
                                    Content="30%"
                                    Tag="30"
                                    Style="{StaticResource PresetButtonStyle}"
                                    Click="TargetPresetButton_Click"/>
                            <Button x:Name="TargetPreset50Button"
                                    Content="50%"
                                    Tag="50"
                                    Style="{StaticResource PresetButtonStyle}"
                                    Click="TargetPresetButton_Click"/>
                            <Button x:Name="TargetPreset70Button"
                                    Content="70%"
                                    Tag="70"
                                    Style="{StaticResource PresetButtonStyle}"
                                    Click="TargetPresetButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2"
                            Margin="0,16,0,0"
                            Padding="15,13"
                            CornerRadius="9"
                            Background="{DynamicResource BadgePackBg}"
                            BorderBrush="{DynamicResource BorderDefault}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Localized 预计大小}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="EstimatedSizeText"
                                           Margin="0,4,0,0"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="EstimateDetailText"
                                           Margin="0,5,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryStrong}"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="42"
                                    Height="42"
                                    CornerRadius="12"
                                    Background="{DynamicResource PanelBackground}">
                                <Path Data="{StaticResource FluentSaveIcon}"
                                      Width="19"
                                      Height="19"
                                      Stretch="Uniform"
                                      Fill="{DynamicResource AccentBlue}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border x:Name="ProgressPanel"
                        Margin="0,16,0,0"
                        Padding="15,14"
                        CornerRadius="9"
                        Background="{DynamicResource ControlBackground}"
                        BorderBrush="{DynamicResource BorderDefault}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ProgressSummaryText"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <controls:SmoothProgressBar x:Name="CompressionProgressBar"
                                                    Style="{StaticResource RoundedSmoothProgressBar}"
                                                    Height="6"
                                                    Margin="0,12,0,0"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    AnimationDuration="200"
                                                    Background="{DynamicResource BorderStrong}"
                                                    Foreground="{DynamicResource AccentBlue}"
                                                    IsIndeterminate="True"/>
                        <TextBlock x:Name="ProgressDetailText"
                                   Margin="0,9,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorText"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerText}"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="OutputHintText"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"/>
            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    MinWidth="92"
                    Content="{loc:Localized 取消}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="CancelButton_Click"/>
            <Button x:Name="StartButton"
                    Grid.Column="3"
                    MinWidth="112"
                    Content="{loc:Localized 开始导出}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="StartButton_Click"/>
        </Grid>
    </Grid>
</Window>
