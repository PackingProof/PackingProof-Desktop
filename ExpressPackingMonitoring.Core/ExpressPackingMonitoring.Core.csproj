<Project Sdk="Microsoft.NET.Sdk">

  <!--
    平台中立的业务核心：录像库、存储策略、Web 服务、备份接收、扩展与工位协议。
    Windows 界面工程与 macOS 主机工程都引用本工程，任何一方都不再按目录猜哪些文件能用。
    本工程只允许跨平台代码：不得引用 WPF、WinForms、注册表或摄像头采集实现。

    注意：核心源码暂时仍与 Windows 界面工程放在同一目录下，这里用显式文件列表声明归属，
    不做任何 glob 或排除。待 Windows 侧改动平稳后再把它们整体搬进本目录，届时只需改路径。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <AssemblyName>ExpressPackingMonitoring.Core</AssemblyName>
    <RootNamespace>ExpressPackingMonitoring</RootNamespace>
    <!--
      版本号以 ExpressPackingMonitoring.csproj 为准；发布脚本会用 -p:Version 全局覆盖。
      Core 保留同值，本地构建与测试才能读到真实版本而不是 0.0.0。
    -->
    <Version>0.0.71</Version>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ExpressPackingMonitoring</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ExpressPackingMonitoring.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ExpressPackingMonitoring.EncodingIntegrationTests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ExpressPackingMonitoring.Host</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

