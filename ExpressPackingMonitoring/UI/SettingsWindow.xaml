                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="播报卖家备注" Style="{StaticResource FieldLabelStyle}"/>
