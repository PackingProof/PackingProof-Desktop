<Window x:Class="ExpressPackingMonitoring.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:ExpressPackingMonitoring.UI"
        Title="设置" Height="760" Width="920"
        MinHeight="680" MinWidth="860"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Icon="/app.ico"
        Background="{DynamicResource WindowBackground}" FontFamily="Microsoft YaHei UI, Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:CqpToQualitySliderConverter x:Key="CqpToQualitySliderConverter"/>
        <local:IntSliderValueConverter x:Key="IntSliderValueConverter"/>
        <local:VideoQualityLabelConverter x:Key="VideoQualityLabelConverter"/>
        <local:AnyTrueConverter x:Key="AnyTrueConverter"/>
        <local:AdvancedModeTextConverter x:Key="AdvancedModeTextConverter"/>
        <!-- 【必需】1. GroupTitle: 用于每个页签顶部的巨大标题 -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,25"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <!-- 【必需】2. SectionHeader: 用于小组标题（如“磁盘矩阵”、“识别规则”） -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,15,0,10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <!-- 【必需】3. SettingRow: 用于每一行设置项的容器边框 -->
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Padding" Value="0,15"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <ControlTemplate x:Key="SettingsComboBoxToggleButtonTemplate" TargetType="{x:Type ToggleButton}">
            <Grid>
                <Border x:Name="Chrome"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"/>
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1"
                            Margin="0,1,1,1"
                            Background="{StaticResource TransparentBrush}"
                            CornerRadius="0,7,7,0"/>
                    <Path x:Name="Arrow"
                          Grid.Column="1"
                          Width="9"
                          Height="5"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="{DynamicResource TextSecondary}"
                          Stretch="Fill"
                          Data="M 0 0 L 4.5 5 L 9 0 Z"/>
                </Grid>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource TextPrimary}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource AccentBlue}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Chrome" Property="Opacity" Value="0.62"/>
                    <Setter TargetName="Arrow" Property="Opacity" Value="0.62"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="SettingsComboBoxTextBoxTemplate" TargetType="{x:Type TextBox}">
            <Border x:Name="PART_ContentHost"
                    Focusable="False"
                    Background="{StaticResource TransparentBrush}"/>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <!-- 显式设置这些属性，切断系统默认样式中 FindAncestor 的错误绑定 -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlBackgroundHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlBackgroundHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BorderLight}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.62"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BorderLight}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Width" Value="260"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="MaxWidth" Value="260"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource SettingsComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,38,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}"
                                     Template="{StaticResource SettingsComboBoxTextBoxTemplate}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="10,0,38,0"
                                     Focusable="True"
                                     Background="{StaticResource TransparentBrush}"
                                     Foreground="{TemplateBinding Foreground}"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Grid x:Name="DropDown"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      SnapsToDevicePixels="True">
                                    <Border x:Name="DropDownBorder"
                                            Margin="0,4,0,0"
                                            Background="{DynamicResource PanelBackground}"
                                            BorderBrush="{DynamicResource BorderStrong}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.18"/>
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True"
                                                      CanContentScroll="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="88"/>
                            </Trigger>
                            <Trigger Property="IsGrouping" Value="True">
                                <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.62"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsButtonSpinnerStyle" TargetType="{x:Type xctk:ButtonSpinner}">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
        </Style>

        <ControlTemplate x:Key="SettingsDoubleUpDownTemplate" TargetType="{x:Type xctk:DoubleUpDown}">
            <Border x:Name="Chrome"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="UnitColumn" Width="Auto"/>
                        <ColumnDefinition x:Name="SpinnerColumn" Width="0"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PART_TextBox"
                             Background="{StaticResource TransparentBrush}"
                             BorderThickness="0"
                             CaretBrush="{DynamicResource AccentBlue}"
                             Foreground="{TemplateBinding Foreground}"
                             HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                             VerticalContentAlignment="Center"
                             Padding="{TemplateBinding Padding}"
                             Margin="0"
                             Focusable="True"/>
                    <TextBlock x:Name="UnitText"
                               Grid.Column="1"
                               Text="{TemplateBinding Tag}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="12"
                               Margin="4,0,10,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <Border x:Name="SpinnerHost"
                            Grid.Column="2"
                            Visibility="Collapsed"
                            Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource BorderLight}"
                            BorderThickness="1,0,0,0"
                            CornerRadius="0,8,8,0">
                        <xctk:ButtonSpinner x:Name="PART_Spinner"
                                            Style="{StaticResource SettingsButtonSpinnerStyle}"
                                            IsTabStop="False"
                                            Margin="0"
                                            BorderThickness="0"
                                            Background="{StaticResource TransparentBrush}"
                                            Foreground="{DynamicResource TextSecondary}"
                                            AllowSpin="{TemplateBinding AllowSpin}"
                                            ShowSpinner="False"/>
                    </Border>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.62"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Null}">
                    <Setter TargetName="UnitColumn" Property="Width" Value="0"/>
                    <Setter TargetName="UnitText" Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="SettingsIntegerUpDownTemplate" TargetType="{x:Type xctk:IntegerUpDown}">
            <Border x:Name="Chrome"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="UnitColumn" Width="Auto"/>
                        <ColumnDefinition x:Name="SpinnerColumn" Width="0"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PART_TextBox"
                             Background="{StaticResource TransparentBrush}"
                             BorderThickness="0"
                             CaretBrush="{DynamicResource AccentBlue}"
                             Foreground="{TemplateBinding Foreground}"
                             HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                             VerticalContentAlignment="Center"
                             Padding="{TemplateBinding Padding}"
                             Margin="0"
                             Focusable="True"/>
                    <TextBlock x:Name="UnitText"
                               Grid.Column="1"
                               Text="{TemplateBinding Tag}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="12"
                               Margin="4,0,10,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <Border x:Name="SpinnerHost"
                            Grid.Column="2"
                            Visibility="Collapsed"
                            Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource BorderLight}"
                            BorderThickness="1,0,0,0"
                            CornerRadius="0,8,8,0">
                        <xctk:ButtonSpinner x:Name="PART_Spinner"
                                            Style="{StaticResource SettingsButtonSpinnerStyle}"
                                            IsTabStop="False"
                                            Margin="0"
                                            BorderThickness="0"
                                            Background="{StaticResource TransparentBrush}"
                                            Foreground="{DynamicResource TextSecondary}"
                                            AllowSpin="{TemplateBinding AllowSpin}"
                                            ShowSpinner="False"/>
                    </Border>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.62"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Null}">
                    <Setter TargetName="UnitColumn" Property="Width" Value="0"/>
                    <Setter TargetName="UnitText" Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="{x:Type xctk:IntegerUpDown}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MaxWidth" Value="120"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template" Value="{StaticResource SettingsIntegerUpDownTemplate}"/>
        </Style>

        <Style TargetType="{x:Type xctk:DoubleUpDown}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MaxWidth" Value="120"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template" Value="{StaticResource SettingsDoubleUpDownTemplate}"/>
        </Style>

        <Thickness x:Key="SectionCardMargin">0,0,0,16</Thickness>
        <Thickness x:Key="SettingRowMargin">0,0,0,14</Thickness>
        <Thickness x:Key="SettingRowLastMargin">0,0,0,0</Thickness>
        <Thickness x:Key="SettingChildRowMargin">24,8,0,0</Thickness>
        <Thickness x:Key="SettingInlineTopMargin">0,12,0,0</Thickness>
        <Thickness x:Key="SectionDividerMargin">0,14,0,14</Thickness>

        <DataTemplate x:Key="StoragePathCellTemplate">
            <TextBlock Text="{Binding Path}"
                       Foreground="{DynamicResource TextPrimary}"
                       VerticalAlignment="Center"
                       Margin="12,0"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Path}"/>
        </DataTemplate>

        <DataTemplate x:Key="StorageReserveCellTemplate">
            <xctk:DoubleUpDown ToolTip="磁盘至少保留多少 GB 不给录像使用。低于安全值时会自动恢复，避免系统或其他软件没空间"
                               Tag="GB"
                               Value="{Binding EffectiveReserveGB, UpdateSourceTrigger=PropertyChanged}"
                               LostFocus="StorageReserveEditor_LostFocus"
                               Increment="1"
                               FormatString="F0"
                               Minimum="1"
                               Maximum="10000"
                               Margin="5"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Width="96"
                               MinWidth="96"
                               MaxWidth="96"
                               Height="36"/>
        </DataTemplate>

        <Style x:Key="StorageGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BorderLight}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
        </Style>

        <Style x:Key="StorageGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsSelected" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundHover}"/>
                </MultiTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BadgePackBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BadgePackText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StorageGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsSelected" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundHover}"/>
                </MultiTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BadgePackBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BadgePackText}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="{StaticResource SectionCardMargin}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="SettingsFooterPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="{DynamicResource AccentBlueDark}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueDark}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style x:Key="SettingsFooterSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="AdvancedModeButtonStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="AutomationProperties.Name"
                    Value="{Binding IsChecked, RelativeSource={RelativeSource Self}, Mode=OneWay, Converter={StaticResource AdvancedModeTextConverter}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Padding="12,10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlBackgroundHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentBlue}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextOnAccent}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentBlueDark}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBlueDark}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextOnAccent}"/>
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FeedbackButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="12,10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlBackgroundHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentBlue}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextOnAccent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="FieldHintStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="16"/>
        </Style>

        <Style x:Key="SettingRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="{StaticResource SettingRowMargin}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsEnabled" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundHover}"/>
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.58"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingRowLastStyle"
               TargetType="Grid"
               BasedOn="{StaticResource SettingRowStyle}">
            <Setter Property="Margin" Value="{StaticResource SettingRowLastMargin}"/>
        </Style>

        <Style x:Key="SettingRowBeforeDividerStyle"
               TargetType="Grid"
               BasedOn="{StaticResource SettingRowStyle}">
            <Setter Property="Margin" Value="{StaticResource SettingRowLastMargin}"/>
        </Style>

        <Style x:Key="SettingChildRowStyle"
               TargetType="Grid"
               BasedOn="{StaticResource SettingRowStyle}">
            <Setter Property="Margin" Value="{StaticResource SettingChildRowMargin}"/>
        </Style>

        <Style x:Key="AdvancedSettingRowStyle"
               TargetType="Grid"
               BasedOn="{StaticResource SettingRowStyle}">
            <Setter Property="Visibility"
                    Value="{Binding Config.ShowAdvancedSettings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
        </Style>

        <Style x:Key="AdvancedSettingRowLastStyle"
               TargetType="Grid"
               BasedOn="{StaticResource AdvancedSettingRowStyle}">
            <Setter Property="Margin" Value="{StaticResource SettingRowLastMargin}"/>
        </Style>

        <Style x:Key="AdvancedSettingRowBeforeDividerStyle"
               TargetType="Grid"
               BasedOn="{StaticResource AdvancedSettingRowStyle}">
            <Setter Property="Margin" Value="{StaticResource SettingRowLastMargin}"/>
        </Style>

        <Style x:Key="AdvancedSettingChildRowStyle"
               TargetType="Grid"
               BasedOn="{StaticResource AdvancedSettingRowStyle}">
            <Setter Property="Margin" Value="{StaticResource SettingChildRowMargin}"/>
        </Style>

        <Style x:Key="SectionDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderLight}"/>
            <Setter Property="Margin" Value="{StaticResource SectionDividerMargin}"/>
        </Style>

        <Style x:Key="SettingsSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TickPlacement" Value="None"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="AutoToolTipPlacement" Value="TopLeft"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="{TemplateBinding Height}" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Track x:Name="PART_Track"
                                   Grid.Row="0"
                                   Height="18"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Focusable="False"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border x:Name="TrackFill"
                                                        Height="6"
                                                        Background="{DynamicResource AccentBlue}"
                                                        CornerRadius="3"
                                                        VerticalAlignment="Center"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="TrackFill" Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="TrackFill" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Focusable="False"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border x:Name="TrackRest"
                                                        Height="6"
                                                        Background="{DynamicResource ControlBackground}"
                                                        BorderBrush="{DynamicResource BorderStrong}"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        VerticalAlignment="Center"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="TrackRest" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                                        <Setter TargetName="TrackRest" Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="SliderThumb"
                                           Width="16"
                                           Height="16"
                                           Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse x:Name="ThumbGlow"
                                                             Width="22"
                                                             Height="22"
                                                             Fill="{DynamicResource AccentBlue}"
                                                             Opacity="0"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                                    <Ellipse x:Name="ThumbChrome"
                                                             Width="16"
                                                             Height="16"
                                                             Fill="{DynamicResource ControlBackground}"
                                                             Stroke="{DynamicResource AccentBlue}"
                                                             StrokeThickness="2"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbGlow" Property="Opacity" Value="0.12"/>
                                                        <Setter TargetName="ThumbChrome" Property="Fill" Value="{DynamicResource ControlBackground}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbGlow" Property="Opacity" Value="0.2"/>
                                                        <Setter TargetName="ThumbChrome" Property="Fill" Value="{DynamicResource AccentBlue}"/>
                                                        <Setter TargetName="ThumbChrome" Property="Stroke" Value="{DynamicResource AccentBlue}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="SliderEndLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <Style x:Key="SliderRecommendedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SliderEndLabelStyle}">
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="MainGrid" Width="44" Height="24" VerticalAlignment="Center">
                            <Border x:Name="BorderUnchecked" CornerRadius="12" Background="{DynamicResource BorderStrong}"/>
                            <Border x:Name="BorderChecked" CornerRadius="12" Background="{DynamicResource AccentBlue}" Opacity="0"/>
                            <Ellipse x:Name="Knob" Width="20" Height="20" Fill="{StaticResource TextOnAccent}" HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.2" Direction="270"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="20" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="BorderChecked"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="BorderChecked"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MainGrid"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.8" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MainGrid"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="SettingsTabControl"
                    Grid.Row="0"
                    TabStripPlacement="Left"
                    Background="{StaticResource TransparentBrush}"
                    BorderThickness="0"
                    Margin="0,0,0,18">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="174"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource ControlBackground}"
                                BorderBrush="{DynamicResource BorderLight}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TabPanel IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1"/>
                                <ToggleButton x:Name="AdvancedModeButton"
                                              Grid.Row="1"
                                              Margin="0,8,0,0"
                                              Style="{StaticResource AdvancedModeButtonStyle}"
                                              IsChecked="{Binding DataContext.Config.ShowAdvancedSettings, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Unchecked="AdvancedModeButton_Unchecked">
                                    <TextBlock Text="{Binding IsChecked, ElementName=AdvancedModeButton, Mode=OneWay, Converter={StaticResource AdvancedModeTextConverter}}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"/>
                                </ToggleButton>
                                <Button x:Name="FeedbackButton"
                                        Grid.Row="2"
                                        Margin="0,8,0,0"
                                        Click="Feedback_Click"
                                        Style="{StaticResource FeedbackButtonStyle}"
                                        AutomationProperties.Name="点击反馈问题">
                                    <TextBlock Text="点击反馈问题"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"/>
                                </Button>
                            </Grid>
                        </Border>

                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                          Grid.Column="1"
                                          ContentSource="SelectedContent"
                                          Margin="18,0,0,0"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="14,11"/>
                    <Setter Property="Margin" Value="0,0,0,6"/>
                    <Setter Property="MinWidth" Value="156"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                    <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="{StaticResource TransparentBrush}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Grid>
                                    <Border Background="{TemplateBinding Background}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            CornerRadius="8">
                                        <ContentPresenter ContentSource="Header"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"
                                                          Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <Border x:Name="SelectionIndicator"
                                            Width="3"
                                            Height="22"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            CornerRadius="0,3,3,0"
                                            Background="{DynamicResource AccentBlue}"
                                            Visibility="Collapsed"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                        <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
                                        <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="IsSelected" Value="False"/>
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                        <Setter Property="Background" Value="{DynamicResource BorderLight}"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="设备与外观">
                <Border Background="{StaticResource TransparentBrush}" Padding="0,4,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="电脑用途" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="选择这台电脑在 PackingProof 中承担的职责"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2"
                                                  SelectedValue="{Binding Config.DeploymentPreset}"
                                                  SelectedValuePath="Tag"
                                                  Cursor="Hand">
                                            <ComboBoxItem Tag="RecordingHost">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource FluentVideoIcon}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource AccentBlue}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="电脑录像并保存在本机"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem Tag="RecordingWorkstation">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource FluentWifiIcon}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource AccentBlue}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="电脑录像并保存到其他电脑"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem Tag="ViewerClient">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource FluentPlayIcon}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource AccentBlue}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="只连接主机查看"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem Tag="MobileBackupHost">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource FluentDatabaseIcon}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource AccentOrange}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="录像文件备份主机"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                        </ComboBox>
                                    </Grid>
                                    <Grid Style="{StaticResource SettingRowStyle}"
                                          Visibility="{Binding Capabilities.CanRecordPcVideo, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="电脑昵称" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="用于区分不同的录像电脑，例如电脑1、电脑2"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <TextBox x:Name="ComputerNicknameTextBox"
                                                 Grid.Column="2"
                                                 MaxLength="20"
                                                 Text="{Binding Config.NodeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="电脑昵称"/>
                                    </Grid>

                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="界面语言" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="默认跟随 Windows 显示语言，修改后重启生效"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2"
                                                  SelectedValue="{Binding Config.Language}"
                                                  SelectedValuePath="Tag"
                                                  Cursor="Hand">
                                            <ComboBoxItem Content="跟随系统" Tag="Auto"/>
                                            <ComboBoxItem Content="简体中文" Tag="zh-Hans"/>
                                            <ComboBoxItem Content="English" Tag="en-US"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="外观主题" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="可跟随系统，或固定为浅色 / 深色主题"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ThemeComboBox"
                                                  Grid.Column="2"
                                                  SelectedValue="{Binding Config.Theme}"
                                                  SelectedValuePath="Tag"
                                                  Cursor="Hand"
                                                  SelectionChanged="ThemeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="跟随系统" Tag="Auto"/>
                                            <ComboBoxItem Content="浅色主题" Tag="Light"/>
                                            <ComboBoxItem Content="深色主题" Tag="Dark"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Style="{StaticResource SettingRowStyle}"
                                          Visibility="{Binding Capabilities.CanUseCamera, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="摄像头" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="选择拍摄打包过程的摄像头"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="CameraComboBox"
                                                  Grid.Column="2"
                                                  SelectedValuePath="Index"
                                                  DisplayMemberPath="Name"
                                                  SelectedValue="{Binding Config.CameraIndex}"
                                                  SelectionChanged="CameraComboBox_SelectionChanged"/>
                                    </Grid>

                                    <Grid x:Name="NetworkCameraPanel"
                                          Style="{StaticResource SettingRowStyle}"
                                          Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                            <TextBlock Text="网络摄像头地址" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="支持 RTSP、RTMP、HTTP 视频流，需手动填写地址"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <Grid Grid.Row="1">
                                            <TextBox x:Name="NetworkCameraUrlTextBox"
                                                     TextChanged="NetworkCameraUrlTextBox_TextChanged"
                                                     ToolTip="rtsp://user:password@192.168.1.64:554/stream"/>
                                            <TextBlock x:Name="NetworkCameraUrlPlaceholderText"
                                                       Text="例如：rtsp://账号:密码@192.168.1.64:554/stream"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                        </Grid>
                                        <StackPanel Grid.Row="2"
                                                    Orientation="Horizontal"
                                                    Margin="0,10,0,0">
                                            <Button x:Name="NetworkCameraTestButton"
                                                    Content="测试连接"
                                                    Height="32"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SecondarySmallButtonStyle}"
                                                    Click="NetworkCameraTestButton_Click"/>
                                            <TextBlock x:Name="NetworkCameraStatusText"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Style="{StaticResource SettingRowStyle}"
                                          Visibility="{Binding Capabilities.CanUseCamera, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="画面旋转 180°" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="摄像头倒装时开启，预览、识别和录像会同步旋转"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="CameraRotate180CheckBox"
                                                  Grid.Column="2"
                                                  IsChecked="{Binding Config.CameraRotate180, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  AutomationProperties.Name="画面旋转 180 度"/>
                                    </Grid>

                                    <Grid Style="{StaticResource SettingRowStyle}"
                                          IsEnabled="{Binding IsChecked, ElementName=AudioRecordCheckBox, TargetNullValue=False}"
                                          Visibility="{Binding Capabilities.CanRecordAudio, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="麦克风" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="选择录制声音使用的麦克风"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="MicComboBox"
                                                  Grid.Column="2"
                                                  SelectedValuePath="Name"
                                                  DisplayMemberPath="Name"
                                                  SelectedValue="{Binding Config.AudioDeviceName}"/>
                                    </Grid>


                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="扫码与识别"
                     Visibility="{Binding Capabilities.CanUseScanner, Converter={StaticResource BoolToVisibility}}">
                <Border Background="{StaticResource TransparentBrush}" Padding="0,4,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 基础扫码设置 -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>

                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="打包模式" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock x:Name="PackingModeHintText"
                                                       Text="推荐连续打包模式，识别或扫描下一张面单时自动保存上一单"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="PackingModeComboBox"
                                                  Grid.Column="2"
                                                  SelectionChanged="PackingModeComboBox_SelectionChanged"
                                                  Cursor="Hand">
                                            <ComboBoxItem Content="连续打包模式（推荐）" Tag="Continuous"/>
                                            <ComboBoxItem Content="同码停录模式" Tag="SameCode"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="摄像头自动识别面单" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="将条形码放入预览引导框，稳定识别后自动开始或切换录像" Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2"
                                                  IsChecked="{Binding Config.EnableCameraBarcodeRecognition}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Style="{StaticResource ToggleSwitchStyle}"/>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="识别频率" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="实时识别跟随摄像头帧率，响应最快；普通电脑保持默认即可"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2"
                                                  SelectedValue="{Binding Config.CameraBarcodeRecognitionSpeed}"
                                                  SelectedValuePath="Tag"
                                                  Cursor="Hand">
                                            <ComboBoxItem Content="实时识别" Tag="Realtime"/>
                                            <ComboBoxItem Content="标准识别（默认）" Tag="Standard"/>
                                            <ComboBoxItem Content="间歇识别" Tag="Intermittent"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="同码消失时间" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="触发开始录像后，原单号离开画面多久才允许再次触发"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="更短" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ElementName=CameraBarcodeRearmSlider, Path=Value, StringFormat={}{0:F1} 秒}"
                                                           Style="{StaticResource SliderValueTextStyle}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="更长" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="CameraBarcodeRearmSlider"
                                                    Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="1"
                                                    Maximum="30"
                                                    TickFrequency="0.5"
                                                    Value="{Binding Config.CameraBarcodeRearmSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="识别区域宽度" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="取景框宽度占画面宽度的比例"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="更小" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ElementName=CameraBarcodeGuideWidthSlider, Path=Value, StringFormat={}{0:P0}}"
                                                           Style="{StaticResource SliderValueTextStyle}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="更大" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="CameraBarcodeGuideWidthSlider"
                                                    Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="0.3"
                                                    Maximum="1"
                                                    TickFrequency="0.05"
                                                    ValueChanged="CameraBarcodeGuideSlider_ValueChanged"
                                                    Value="{Binding Config.CameraBarcodeGuideWidthRatio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="识别区域高度" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="取景框高度占画面高度的比例"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="更小" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ElementName=CameraBarcodeGuideHeightSlider, Path=Value, StringFormat={}{0:P0}}"
                                                           Style="{StaticResource SliderValueTextStyle}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="更大" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="CameraBarcodeGuideHeightSlider"
                                                    Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="0.3"
                                                    Maximum="1"
                                                    TickFrequency="0.05"
                                                    ValueChanged="CameraBarcodeGuideSlider_ValueChanged"
                                                    Value="{Binding Config.CameraBarcodeGuideHeightRatio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="左右偏移" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="取景框的左右位置，0 表示居中"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="偏左" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ElementName=CameraBarcodeGuideOffsetXSlider, Path=Value, StringFormat={}{0:P0}}"
                                                           Style="{StaticResource SliderValueTextStyle}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="偏右" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="CameraBarcodeGuideOffsetXSlider"
                                                    Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="-1"
                                                    Maximum="1"
                                                    TickFrequency="0.05"
                                                    ValueChanged="CameraBarcodeGuideSlider_ValueChanged"
                                                    Value="{Binding Config.CameraBarcodeGuideOffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="上下偏移" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="取景框的上下位置，0 表示居中"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="偏上" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ElementName=CameraBarcodeGuideOffsetYSlider, Path=Value, StringFormat={}{0:P0}}"
                                                           Style="{StaticResource SliderValueTextStyle}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="偏下" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="CameraBarcodeGuideOffsetYSlider"
                                                    Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="-1"
                                                    Maximum="1"
                                                    TickFrequency="0.05"
                                                    ValueChanged="CameraBarcodeGuideSlider_ValueChanged"
                                                    Value="{Binding Config.CameraBarcodeGuideOffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="识别确认时间" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="识别到条码后，在该时间内达到确认次数即可触发开始、切换或停录"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="更短" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ElementName=CameraSameBarcodeConfirmationSlider, Path=Value, StringFormat={}{0:F1} 秒}"
                                                           Style="{StaticResource SliderValueTextStyle}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="更长" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="CameraSameBarcodeConfirmationSlider"
                                                    Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="0.5"
                                                    Maximum="10"
                                                    TickFrequency="0.5"
                                                    Value="{Binding Config.CameraSameBarcodeConfirmationSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="识别确认次数" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="需要识别到几次才触发，次数越少响应越快"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="CameraSameBarcodeConfirmationHitsComboBox"
                                                  Grid.Column="2"
                                                  SelectedValue="{Binding Config.CameraSameBarcodeConfirmationHits}"
                                                  SelectedValuePath="Tag"
                                                  Cursor="Hand">
                                            <ComboBoxItem Content="1 次（最快）" Tag="1"/>
                                            <ComboBoxItem Content="2 次（推荐）" Tag="2"/>
                                            <ComboBoxItem Content="3 次（更稳）" Tag="3"/>
                                            <ComboBoxItem Content="4 次（最稳）" Tag="4"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 基础扫码设置 -->
                            <Border Style="{StaticResource SectionCardStyle}"
                                    Visibility="{Binding Config.ShowAdvancedSettings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>

                                    <Grid Style="{StaticResource AdvancedSettingRowStyle}"
                                          ToolTip="正则表达式用于过滤非法扫码内容。不了解正则时请不要修改">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="单号判断规则" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="用于判断扫码内容是不是有效单号"
                                                    Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <TextBox Grid.Column="2"
                                                HorizontalAlignment="Stretch"
                                                Text="{Binding Config.OrderIdRegex}"/>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowLastStyle}"
                                          ToolTip="扫码枪可能连续发送多次内容，这里用于避免重复触发录制切换">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="扫码间隔保护" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="防止扫码枪连续触发太快"
                                                    Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="更灵敏" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ElementName=BarcodeCooldownSlider, Path=Value, StringFormat={}{0:F1} 秒}"
                                                        Style="{StaticResource SliderValueTextStyle}"
                                                        HorizontalAlignment="Center"/>
                                                <TextBlock Text="更稳妥" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="BarcodeCooldownSlider"
                                                    Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="0.5"
                                                    Maximum="10"
                                                    TickFrequency="0.5"
                                                    Value="{Binding Config.BarcodeCooldownSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 扫码枪识别模式 -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="全局键盘监听" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="软件在后台也能扫码开始录制"
                                                    Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="GlobalKeyboardCheckBox"
                                                Grid.Column="2"
                                                IsChecked="{Binding Config.EnableGlobalKeyboard}"
                                                Checked="GlobalKeyboardCheckBox_Checked"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource ToggleSwitchStyle}"/>
                                    </Grid>

                                    <Grid Style="{StaticResource SettingRowStyle}"
                                        ToolTip="扫码枪没有自动回车时使用。只在软件窗口内识别，避免影响其他程序输入">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="无回车窗口内识别" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="扫码枪没开自动回车时打开。需要软件窗口在前台"
                                                    Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ScannerAutoSubmitCheckBox"
                                                Grid.Column="2"
                                                IsChecked="{Binding Config.EnableScannerAutoSubmit}"
                                                Checked="ScannerAutoSubmitCheckBox_Checked"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource ToggleSwitchStyle}"/>
                                    </Grid>

                                    <StackPanel>
                                        <StackPanel.IsEnabled>
                                            <MultiBinding Converter="{StaticResource AnyTrueConverter}">
                                                <Binding ElementName="GlobalKeyboardCheckBox" Path="IsChecked"/>
                                                <Binding ElementName="ScannerAutoSubmitCheckBox" Path="IsChecked"/>
                                            </MultiBinding>
                                        </StackPanel.IsEnabled>
                                        <Grid Style="{StaticResource AdvancedSettingRowStyle}"
                                              ToolTip="扫码内容至少达到这个长度才会提交。全局键盘监听和无回车窗口内识别都会用到">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="260"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="扫码最小长度" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBlock Text="太短的不当作单号，防止误触发"
                                                        Style="{StaticResource FieldHintStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <Grid>
                                                    <TextBlock Text="更灵敏" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                    <TextBlock Text="{Binding ElementName=ScannerAutoSubmitMinLengthSlider, Path=Value, StringFormat={}{0:F0} 位}"
                                                            Style="{StaticResource SliderValueTextStyle}"
                                                            HorizontalAlignment="Center"/>
                                                    <TextBlock Text="更稳妥" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider x:Name="ScannerAutoSubmitMinLengthSlider"
                                                        Style="{StaticResource SettingsSliderStyle}"
                                                        Minimum="4"
                                                        Maximum="30"
                                                        TickFrequency="1"
                                                        IsSnapToTickEnabled="True"
                                                        Value="{Binding Config.ScannerAutoSubmitMinLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource IntSliderValueConverter}}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Style="{StaticResource AdvancedSettingRowStyle}"
                                              ToolTip="无回车窗口内识别时，最后一次输入后超过这个时间没有新字符，才判断一次扫码是否完成">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="260"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="自动提交停顿" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBlock Text="停顿越短越灵敏，越长越不易误触"
                                                        Style="{StaticResource FieldHintStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <Grid>
                                                    <TextBlock Text="更灵敏" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                    <TextBlock Text="{Binding ElementName=ScannerAutoSubmitQuietSlider, Path=Value, StringFormat={}{0:F0} ms}"
                                                            Style="{StaticResource SliderValueTextStyle}"
                                                            HorizontalAlignment="Center"/>
                                                    <TextBlock Text="更稳妥" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider x:Name="ScannerAutoSubmitQuietSlider"
                                                        Style="{StaticResource SettingsSliderStyle}"
                                                        Minimum="120"
                                                        Maximum="600"
                                                        TickFrequency="20"
                                                        IsSnapToTickEnabled="True"
                                                        Value="{Binding Config.ScannerAutoSubmitQuietMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource IntSliderValueConverter}}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Style="{StaticResource AdvancedSettingRowStyle}"
                                              ToolTip="连续字符平均间隔低于该值时，认为更像扫码枪高速输入">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="260"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="平均输入间隔" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBlock Text="数值越小，对手动输入越严格"
                                                        Style="{StaticResource FieldHintStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <Grid>
                                                    <TextBlock Text="更严格" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                    <TextBlock Text="{Binding ElementName=ScannerAutoSubmitAverageSlider, Path=Value, StringFormat={}{0:F0} ms}"
                                                            Style="{StaticResource SliderValueTextStyle}"
                                                            HorizontalAlignment="Center"/>
                                                    <TextBlock Text="更宽松" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider x:Name="ScannerAutoSubmitAverageSlider"
                                                        Style="{StaticResource SettingsSliderStyle}"
                                                        Minimum="10"
                                                        Maximum="100"
                                                        TickFrequency="5"
                                                        IsSnapToTickEnabled="True"
                                                        Value="{Binding Config.ScannerAutoSubmitMaxAverageIntervalMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource IntSliderValueConverter}}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Style="{StaticResource AdvancedSettingRowLastStyle}"
                                              ToolTip="多数连续字符间隔低于该值时，也可认为是扫码枪输入">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="260"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="单字符间隔上限" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBlock Text="用于兼容偶尔有抖动的扫码枪"
                                                        Style="{StaticResource FieldHintStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <Grid>
                                                    <TextBlock Text="更严格" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                    <TextBlock Text="{Binding ElementName=ScannerAutoSubmitKeyIntervalSlider, Path=Value, StringFormat={}{0:F0} ms}"
                                                            Style="{StaticResource SliderValueTextStyle}"
                                                            HorizontalAlignment="Center"/>
                                                    <TextBlock Text="更宽松" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider x:Name="ScannerAutoSubmitKeyIntervalSlider"
                                                        Style="{StaticResource SettingsSliderStyle}"
                                                        Minimum="20"
                                                        Maximum="150"
                                                        TickFrequency="5"
                                                        IsSnapToTickEnabled="True"
                                                        Value="{Binding Config.ScannerAutoSubmitMaxKeyIntervalMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource IntSliderValueConverter}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="面单放大"
                     Visibility="{Binding Capabilities.CanRecordPcVideo, Converter={StaticResource BoolToVisibility}}">
                <Border Background="{StaticResource TransparentBrush}" Padding="0,4,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="启用面单放大" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="录制开始时先放大中心画面，停留一会儿后再恢复"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SmartZoomCheckBox"
                                                  Grid.Column="2"
                                                  IsChecked="{Binding Config.EnableSmartZoom}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Style="{StaticResource ToggleSwitchStyle}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}"
                                    IsEnabled="{Binding IsChecked, ElementName=SmartZoomCheckBox, TargetNullValue=False}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="放大倍数" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="倍率越高，面单越清楚，但画面范围越小"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="范围大" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ElementName=ZoomScaleSlider, Path=Value, StringFormat={}{0:F1} 倍}"
                                                           Style="{StaticResource SliderValueTextStyle}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="面单大" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="ZoomScaleSlider"
                                                    Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="1.2"
                                                    Maximum="4.0"
                                                    TickFrequency="0.1"
                                                    Value="{Binding Config.ZoomScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    ValueChanged="ZoomScaleSlider_ValueChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="放大前等待" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="开始录制后等待多久再放大"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="更快" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ElementName=ZoomDelaySlider, Path=Value, StringFormat={}{0:F1} 秒}"
                                                           Style="{StaticResource SliderValueTextStyle}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="更慢" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="ZoomDelaySlider"
                                                    Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="0"
                                                    Maximum="5"
                                                    TickFrequency="0.5"
                                                    Value="{Binding Config.ZoomDelaySeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowBeforeDividerStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="放大停留时间" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="放大画面保持多久后恢复"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="更短" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ElementName=ZoomDurationSlider, Path=Value, StringFormat={}{0:F1} 秒}"
                                                           Style="{StaticResource SliderValueTextStyle}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="更长" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="ZoomDurationSlider"
                                                    Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="0"
                                                    Maximum="10"
                                                    TickFrequency="0.5"
                                                    Value="{Binding Config.ZoomDurationSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource SectionDividerStyle}"
                                            Visibility="{Binding Config.ShowAdvancedSettings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>

                                    <Grid Style="{StaticResource AdvancedSettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="平滑过渡" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="开启后放大和恢复时会有平滑动画"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ZoomAnimationCheckBox"
                                                  Grid.Column="2"
                                                  IsChecked="{Binding Config.EnableZoomAnimation}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Style="{StaticResource ToggleSwitchStyle}"/>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowLastStyle}"
                                          IsEnabled="{Binding IsChecked, ElementName=ZoomAnimationCheckBox, TargetNullValue=False}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="过渡时长" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="动画持续时间"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="更快" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ElementName=ZoomAnimationSlider, Path=Value, StringFormat={}{0:F0} ms}"
                                                           Style="{StaticResource SliderValueTextStyle}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="更柔和" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="ZoomAnimationSlider"
                                                    Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="50"
                                                    Maximum="2000"
                                                    TickFrequency="50"
                                                    Value="{Binding Config.ZoomAnimationDurationMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="存储与备份"
                     Visibility="{Binding Capabilities.CanConfigureStorage, Converter={StaticResource BoolToVisibility}}">
                <Border Background="{StaticResource TransparentBrush}" Padding="0,4,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Height="8"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding CurrentDiskUsagePercent}"
                                                     Foreground="{DynamicResource AccentBlue}"
                                                     Background="{DynamicResource BorderStrong}"
                                                     BorderThickness="0"
                                                     VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CurrentDiskUsageText}"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="16,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <Grid Style="{StaticResource SettingRowLastStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="260"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="录像清理"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock Text="清理只影响电脑本地录像，NAS 中已备份的文件不会受到影响"
                                                   Style="{StaticResource FieldHintStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button x:Name="BtnManualCleanupByTime"
                                                Content="按时间清理…"
                                                Click="BtnManualCleanupByTime_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,10,0"/>
                                        <Button x:Name="BtnManualCleanupBySpace"
                                                Content="按空间释放…"
                                                Click="BtnManualCleanupBySpace_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="录像保存位置" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="本地磁盘直接保存录像，空间不足时按保护期自动循环清理"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border BorderBrush="{DynamicResource BorderLight}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Background="{DynamicResource ControlBackground}">
                                        <DataGrid x:Name="StorageDataGrid"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  HorizontalGridLinesBrush="{DynamicResource BorderLight}"
                                                  BorderThickness="0"
                                                  Background="{StaticResource TransparentBrush}"
                                                  Foreground="{DynamicResource TextPrimary}"
                                                  RowHeight="50"
                                                  FontSize="13"
                                                  SelectionMode="Single"
                                                  SelectionChanged="StorageDataGrid_SelectionChanged"
                                                  CanUserSortColumns="False"
                                                  ColumnHeaderStyle="{StaticResource StorageGridColumnHeaderStyle}"
                                                  RowStyle="{StaticResource StorageGridRowStyle}"
                                                  CellStyle="{StaticResource StorageGridCellStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="存储路径"
                                                                        Width="*"
                                                                        CellTemplate="{StaticResource StoragePathCellTemplate}"/>
                                                <DataGridTemplateColumn Header="预留空间"
                                                                        Width="150"
                                                                        CellTemplate="{StaticResource StorageReserveCellTemplate}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                    <TextBlock Text="录像会按列表顺序保存。某个磁盘只剩下预留空间时，会自动换到下一个磁盘；系统盘默认至少预留 30GB 或 10%，其他磁盘至少预留 20GB 或 5%，以较大值为准"
                                               Style="{StaticResource FieldHintStyle}"
                                               Margin="0,10,0,0"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource SettingInlineTopMargin}">
                                        <Button Content="添加磁盘"
                                                Click="BtnAddStorage_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,10,0"/>
                                        <Button x:Name="RemoveStorageButton"
                                                Content="移除选中"
                                                Click="BtnRemoveStorage_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,10,0"
                                                IsEnabled="False"/>
                                        <Button x:Name="MoveStorageUpButton"
                                                Content="上移"
                                                Click="BtnMoveStorageUp_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,10,0"
                                                IsEnabled="False"/>
                                        <Button x:Name="MoveStorageDownButton"
                                                Content="下移"
                                                Click="BtnMoveStorageDown_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                IsEnabled="False"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="录像备份位置" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Text="录像会按列表顺序备份到当前可用的位置；NAS 满时自动切换到下一个，NAS 中已备份的文件不会被程序删除"
                                               Style="{StaticResource FieldHintStyle}"/>
                                    <Border BorderBrush="{DynamicResource BorderLight}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Background="{DynamicResource ControlBackground}">
                                        <DataGrid x:Name="BackupStorageDataGrid"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  HorizontalGridLinesBrush="{DynamicResource BorderLight}"
                                                  BorderThickness="0"
                                                  Background="{StaticResource TransparentBrush}"
                                                  Foreground="{DynamicResource TextPrimary}"
                                                  RowHeight="50"
                                                  FontSize="13"
                                                  SelectionMode="Single"
                                                  SelectionChanged="BackupStorageDataGrid_SelectionChanged"
                                                  CanUserSortColumns="False"
                                                  ColumnHeaderStyle="{StaticResource StorageGridColumnHeaderStyle}"
                                                  RowStyle="{StaticResource StorageGridRowStyle}"
                                                  CellStyle="{StaticResource StorageGridCellStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="存储路径"
                                                                        Width="*"
                                                                        CellTemplate="{StaticResource StoragePathCellTemplate}"/>
                                                <DataGridTemplateColumn Header="预留空间"
                                                                        Width="150"
                                                                        CellTemplate="{StaticResource StorageReserveCellTemplate}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                    <TextBlock x:Name="BackupEmptyHint"
                                               Text="尚未配置网络备份位置；本地磁盘不能作为备份位置"
                                               Style="{StaticResource FieldHintStyle}"
                                               Foreground="{DynamicResource AccentOrange}"
                                               Margin="0,8,0,0"
                                               Visibility="Collapsed"/>
                                    <TextBlock Text="备份位置至少预留 10GB 或 2%；校验通过后才会清理旧本地副本；NAS 满时自动切换到下一个可用位置，全部不足时才暂停并提示；程序不会删除 NAS 上的文件；NAS 不可用且磁盘空间不足时，会先清理已归档副本，再按 30 分钟保护期分档清理最旧未归档录像"
                                               Style="{StaticResource FieldHintStyle}"
                                               Margin="0,10,0,0"/>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="{StaticResource SettingInlineTopMargin}">
                                        <Button x:Name="BtnAddBackupStorage"
                                                Content="添加网络位置"
                                                Click="BtnAddNetworkStorage_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,10,0"/>
                                        <Button x:Name="BackupRemoveButton"
                                                Content="移除选中"
                                                Click="BtnRemoveBackupStorage_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,10,0"
                                                IsEnabled="False"/>
                                        <Button x:Name="BackupMoveUpButton"
                                                Content="上移"
                                                Click="BtnBackupMoveUp_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,10,0"
                                                IsEnabled="False"/>
                                        <Button x:Name="BackupMoveDownButton"
                                                Content="下移"
                                                Click="BtnBackupMoveDown_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                IsEnabled="False"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}"
                                    Visibility="{Binding Config.ShowAdvancedSettings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <Grid Style="{StaticResource AdvancedSettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="最小文件大小" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="小于该大小的视频会自动删除；填 0 表示不限制"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="更宽松" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ElementName=MinVideoFileSizeSlider, Path=Value, StringFormat={}{0:F0} KB}"
                                                           Style="{StaticResource SliderValueTextStyle}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="更严格" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="MinVideoFileSizeSlider"
                                                    Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="0"
                                                    Maximum="20480"
                                                    TickFrequency="1024"
                                                    Value="{Binding Config.MinVideoFileSizeKB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource IntSliderValueConverter}}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowLastStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="显示已清理记录" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="视频文件被清理后，列表里仍显示这条记录"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2"
                                                  IsChecked="{Binding Config.ShowDeletedVideos}"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem x:Name="RecordingCacheTabItem"
                     Header="存储与备份"
                     Visibility="{Binding Capabilities.CanConfigureRecordingCache, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Border Background="{StaticResource TransparentBrush}" Padding="0,4,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="本机录像缓存" Style="{StaticResource GroupTitle}"/>
                                    <TextBlock Text="录像会先保存在本机。保存主机确认接收后，系统会根据缓存上限自动清理已上传文件"
                                               Style="{StaticResource FieldHintStyle}"
                                               Margin="0,0,0,16"/>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar x:Name="RecordingCacheUsageProgress"
                                                     Height="8"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding CurrentDiskUsagePercent, Mode=OneWay}"
                                                     Foreground="{DynamicResource AccentBlue}"
                                                     Background="{DynamicResource BorderStrong}"
                                                     BorderThickness="0"
                                                     VerticalAlignment="Center"/>
                                        <TextBlock x:Name="RecordingCacheUsageText"
                                                   Grid.Column="1"
                                                   Text="{Binding CurrentDiskUsageText, Mode=OneWay}"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="16,0,0,0"/>
                                    </Grid>

                                    </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="缓存位置" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="录制工位只使用一个本地缓存位置，不会自动移动或删除原有录像"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <Grid Grid.Column="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Config.StorageLocations[0].Path, Mode=OneWay}"
                                                     Height="36"
                                                     IsReadOnly="True"
                                                     VerticalContentAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    Content="更改位置"
                                                    Height="36"
                                                    Padding="12,0"
                                                    Margin="8,0,0,0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="BtnBrowseRecordingCache_Click"/>
                                        </Grid>
                                    </Grid>
                                    <TextBlock x:Name="RecordingCacheDriveHintText"
                                               Text="系统会为磁盘保留安全空间"
                                               Style="{StaticResource FieldHintStyle}"
                                               Margin="0,6,0,0"/>

                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="缓存最多占用" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="默认 100 GB，只是最高上限，不会预占磁盘空间"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <xctk:IntegerUpDown x:Name="RecordingCacheLimitEditor"
                                                                Value="{Binding Config.RecordingCacheMaxGB, Mode=TwoWay}"
                                                                Minimum="1"
                                                                Maximum="10240"
                                                                Increment="1"
                                                                Height="36"
                                                                Width="120"
                                                                ValueChanged="RecordingCacheLimitEditor_ValueChanged"/>
                                            <TextBlock Text="GB"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="RecordingCacheSafeCapacityText"
                                               Text="正在计算此磁盘可安全使用的空间"
                                               Style="{StaticResource FieldHintStyle}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="录像设置"
                     Visibility="{Binding Capabilities.CanRecordPcVideo, Converter={StaticResource BoolToVisibility}}">
                <Border Background="{StaticResource TransparentBrush}" Padding="0,4,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRowStyle}"
                                          Visibility="{Binding Capabilities.CanRecordAudio, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="录制声音" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="需要保留现场声音时开启"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="AudioRecordCheckBox"
                                                  Grid.Column="2"
                                                  IsChecked="{Binding Config.EnableAudioRecording}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Style="{StaticResource ToggleSwitchStyle}"/>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowStyle}"
                                          ToolTip="H.265/HEVC 体积更小，但部分电脑或浏览器可能无法直接播放；H.264 兼容性更好">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="视频编码格式" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="影响录像体积和播放兼容性"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="VideoCodecComboBox"
                                                  Grid.Column="2"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="DisplayName"
                                                  Cursor="Hand"/>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowStyle}"
                                          ToolTip="优先使用显卡进行视频编码，可降低 CPU 占用；如果录像异常，可改为自动或 CPU">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="硬件加速" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="用显卡帮忙录像，降低电脑占用"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="GpuEncoderComboBox"
                                                  Grid.Column="2"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="DisplayName"
                                                  Cursor="Hand"/>
                                    </Grid>

                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="分辨率" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="越高越清晰，文件也越大"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ResComboBox"
                                                  Grid.Column="2"
                                                  DisplayMemberPath="Name"
                                                  Cursor="Hand"/>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="画面流畅度" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="越高越流畅，也更占空间"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="FpsComboBox" Grid.Column="2"
                                                  Height="32"
                                                  Cursor="Hand"/>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowLastStyle}"
                                          ToolTip="底层仍保存为 CQP。CQP 数值越小越清晰、文件越大；这里用更直观的方向显示">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="画质与文件大小" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="往右更清晰，往左更省空间"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="省空间" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ElementName=VideoQualitySlider, Path=Value, Converter={StaticResource VideoQualityLabelConverter}}"
                                                           Style="{StaticResource SliderValueTextStyle}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="更清晰" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="VideoQualitySlider"
                                                    Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    TickFrequency="2"
                                                    Value="{Binding Config.VideoCqp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource CqpToQualitySliderConverter}}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="画面没变化时自动结束录像" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="打包结束后画面不动，就自动停止录像"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="AutoStopCheckBox"
                                                  Grid.Column="2"
                                                  IsChecked="{Binding Config.EnableAutoStop}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Style="{StaticResource ToggleSwitchStyle}"/>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowStyle}"
                                          IsEnabled="{Binding IsChecked, ElementName=AutoStopCheckBox, TargetNullValue=False}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="静止超时" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="画面不动超过这个时间后停止录像"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="更短" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ElementName=AutoStopSlider, Path=Value, StringFormat={}{0:F1} 分钟}"
                                                           Style="{StaticResource SliderValueTextStyle}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="更长" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="AutoStopSlider"
                                                    Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="0.1"
                                                    Maximum="60"
                                                    TickFrequency="0.5"
                                                    Value="{Binding Config.AutoStopMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowBeforeDividerStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="提前提醒时间" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="快要自动停止录像前，提前多久提醒"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="更晚" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ElementName=TimeoutWarningSlider, Path=Value, StringFormat={}{0:F0} 秒}"
                                                           Style="{StaticResource SliderValueTextStyle}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="更早" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="TimeoutWarningSlider"
                                                    Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="3"
                                                    Maximum="120"
                                                    TickFrequency="1"
                                                    Value="{Binding Config.TimeoutWarningSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource SectionDividerStyle}"/>

                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="限制录像时长" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="防止单个录像录得太久"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="MaxDurationCheckBox"
                                                  Grid.Column="2"
                                                  IsChecked="{Binding Config.EnableMaxDuration}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Style="{StaticResource ToggleSwitchStyle}"/>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowBeforeDividerStyle}"
                                          IsEnabled="{Binding IsChecked, ElementName=MaxDurationCheckBox, TargetNullValue=False}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="最大时长" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="单个录像超过这个时间就自动停止"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="更短" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ElementName=MaxDurationSlider, Path=Value, StringFormat={}{0:F1} 分钟}"
                                                           Style="{StaticResource SliderValueTextStyle}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="更长" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="MaxDurationSlider"
                                                    Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="0.1"
                                                    Maximum="60"
                                                    TickFrequency="0.5"
                                                    Value="{Binding Config.MaxDurationMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource SectionDividerStyle}"/>

                                    <Grid Style="{StaticResource AdvancedSettingRowBeforeDividerStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="太短的视频自动丢弃" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="少于这个时长的视频不保存"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="更宽松" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ElementName=MinRecordingSlider, Path=Value, StringFormat={}{0:F0} 秒}"
                                                           Style="{StaticResource SliderValueTextStyle}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="更严格" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="MinRecordingSlider"
                                                    Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="0"
                                                    Maximum="30"
                                                    TickFrequency="1"
                                                    Value="{Binding Config.MinRecordingSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource SectionDividerStyle}"
                                            Visibility="{Binding Config.ShowAdvancedSettings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>

                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="长时间不用时关闭摄像头" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="空闲时省资源，有操作时再恢复"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="CameraIdleCheckBox"
                                                  Grid.Column="2"
                                                  IsChecked="{Binding Config.EnableCameraIdle}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Style="{StaticResource ToggleSwitchStyle}"/>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowStyle}"
                                          IsEnabled="{Binding IsChecked, ElementName=CameraIdleCheckBox, TargetNullValue=False}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="空闲超时" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="空闲超过这个时间后关闭摄像头"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="更快休眠" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ElementName=CameraIdleSlider, Path=Value, StringFormat={}{0:F0} 分钟}"
                                                           Style="{StaticResource SliderValueTextStyle}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="更久在线" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="CameraIdleSlider"
                                                    Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="1"
                                                    Maximum="480"
                                                    TickFrequency="5"
                                            Value="{Binding Config.CameraIdleMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowLastStyle}"
                                          IsEnabled="{Binding IsChecked, ElementName=CameraIdleCheckBox, TargetNullValue=False}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="高峰时段不休眠" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="达到空闲超时时才检查，两个时段默认留空"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="82"/>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="82"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="时段 1" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Config.CameraIdleNoSleepStart1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         MaxLength="5" TextAlignment="Center" ToolTip="时间格式为 HH:mm"/>
                                                <TextBlock Grid.Column="2" Text="至" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                                <TextBox Grid.Column="3"
                                                         Text="{Binding Config.CameraIdleNoSleepEnd1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         MaxLength="5" TextAlignment="Center" ToolTip="时间格式为 HH:mm"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="82"/>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="82"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="时段 2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Config.CameraIdleNoSleepStart2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         MaxLength="5" TextAlignment="Center" ToolTip="时间格式为 HH:mm"/>
                                                <TextBlock Grid.Column="2" Text="至" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                                <TextBox Grid.Column="3"
                                                         Text="{Binding Config.CameraIdleNoSleepEnd2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         MaxLength="5" TextAlignment="Center" ToolTip="时间格式为 HH:mm"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="启用录像水印" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="方便事后确认这段录像对应哪个订单"
                                                    Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2"
                                                IsChecked="{Binding Config.EnableWatermark}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource ToggleSwitchStyle}"/>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="接收第三方水印" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="允许称重等第三方程序把数据显示到录像水印中"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2"
                                                  IsChecked="{Binding Config.EnableThirdPartyWatermark}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  AutomationProperties.Name="接收第三方水印"/>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowStyle}"
                                          IsEnabled="{Binding IsChecked, ElementName=AudioRecordCheckBox, Mode=OneWay, TargetNullValue=False}"
                                          ToolTip="兼容性提示：部分麦克风、驱动或 FFmpeg 环境可能出现录制启动失败、声音缺失或不同步">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="音频直接写入 MKV" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="将声音直接编码到临时录像文件，减少临时文件和后处理"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="DirectAacRecordingCheckBox"
                                                  Grid.Column="2"
                                                  IsChecked="{Binding Config.EnableDirectAacRecording, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Checked="DirectAacRecordingCheckBox_Checked"
                                                  PreviewMouseLeftButtonDown="DirectAacRecordingCheckBox_PreviewMouseLeftButtonDown"
                                                  PreviewKeyDown="DirectAacRecordingCheckBox_PreviewKeyDown"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  AutomationProperties.Name="音频直接写入 MKV"/>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowLastStyle}"
                                          ToolTip="负数表示让音频提前，正数表示让音频延后；通常保持 0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="声音同步微调" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="只有声音和画面不同步时再调整"
                                                    Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="更提前" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding Config.AudioSyncOffsetMs, Mode=OneWay, StringFormat={}{0} ms}"
                                                           Style="{StaticResource SliderValueTextStyle}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="更延后" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="-2000"
                                                    Maximum="2000"
                                                    TickFrequency="50"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding Config.AudioSyncOffsetMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
</StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="声音与播报"
                     Visibility="{Binding Capabilities.IsRecordingDevice, Converter={StaticResource BoolToVisibility}}">
                <Border Background="{StaticResource TransparentBrush}" Padding="0,4,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SoundSettingsPanel" Loaded="SoundSettingsPanel_Loaded">
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="语音提醒" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="开启后，超时、停录和订单信息会用语音提醒"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SoundPromptCheckBox"
                                                  Grid.Column="2"
                                                  IsChecked="{Binding Config.EnableSoundPrompt}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Style="{StaticResource ToggleSwitchStyle}"/>
                                    </Grid>

                                    <Grid Style="{StaticResource SettingRowStyle}"
                                          IsEnabled="{Binding IsChecked, ElementName=SoundPromptCheckBox, TargetNullValue=False}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="播报音量最大" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="每次播报前取消静音并将电脑音量调到最大"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2"
                                                  IsChecked="{Binding Config.MaximizeVolumeForSpeech}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Style="{StaticResource ToggleSwitchStyle}"/>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowStyle}"
                                          ToolTip="系统语音不需要网络；联网语音声音更自然；离线语音使用本地模型，需要额外运行依赖"
                                          IsEnabled="{Binding IsChecked, ElementName=SoundPromptCheckBox, TargetNullValue=False}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="语音引擎" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="选择提醒声音使用系统语音、联网语音还是离线语音"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="VoiceEngineComboBox"
                                                  Grid.Column="2"
                                                  Width="220"
                                                  HorizontalAlignment="Left"
                                                  SelectedValuePath="Tag"
                                                  SelectionChanged="VoiceEngineComboBox_SelectionChanged">
                                            <ComboBoxItem Content="系统语音" Tag="System"/>
                                            <ComboBoxItem Content="联网语音" Tag="Edge"/>
                                            <ComboBoxItem Content="离线语音" Tag="Kokoro"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0">
                                        <Grid.Style>
                                            <Style TargetType="Grid" BasedOn="{StaticResource AdvancedSettingRowStyle}">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsChecked, ElementName=SoundPromptCheckBox}" Value="True"/>
                                                            <Condition Binding="{Binding SelectedValue, ElementName=VoiceEngineComboBox}" Value="Edge"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsChecked, ElementName=SoundPromptCheckBox}" Value="True"/>
                                                            <Condition Binding="{Binding SelectedValue, ElementName=VoiceEngineComboBox}" Value="Kokoro"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="语速" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="调整播报快慢"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="更慢" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ElementName=AiTtsSpeedSlider, Path=Value, StringFormat={}{0:F1} 倍}"
