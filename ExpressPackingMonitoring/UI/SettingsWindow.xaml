                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2"
                                                  Width="260"
                                                  HorizontalAlignment="Left"
                                                  IsTextSearchEnabled="True"
