                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="播报买家留言" Style="{StaticResource FieldLabelStyle}"/>
