                                </StackPanel>
                            </Border>
</StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="局域网与网页"
                     Visibility="{Binding Capabilities.CanRunWebServer, Converter={StaticResource BoolToVisibility}}">
                <Border Background="{StaticResource TransparentBrush}" Padding="0,4,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource SectionCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="手机/电脑连接" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock Margin="0,5,0,0"
                                                   Style="{StaticResource FieldHintStyle}"
                                                   TextWrapping="Wrap">
                                            <Run Text="当前地址："/>
                                            <Run Text="{Binding ConnectionAddress, Mode=OneWay, TargetNullValue=尚未准备}"/>
                                        </TextBlock>
                                        <TextBlock Text="手机或其他电脑连接同一个局域网后，可扫码或复制网址打开录像网页"
                                                   Style="{StaticResource FieldHintStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="显示二维码"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,8,0"
                                                Click="ShowMobileConnection_Click"/>
                                        <Button Content="复制网址"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="CopyMobileConnectionUrl_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource AdvancedSettingRowStyle}"
                                          ToolTip="端口是浏览器访问服务时使用的数字，例如 http://电脑IP:端口">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="网页访问端口" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="浏览器访问用的端口，保存后自动重启服务"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <xctk:IntegerUpDown Grid.Column="2"
                                                            Height="36"
                                                            Value="{Binding Config.WebServerPort}"
                                                            Minimum="1024"
                                                            Maximum="65535"
                                                            Increment="1"/>
                                    </Grid>

                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="保护录像网页" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="访问录像、播放和剪辑时验证专用链接，订单插件不受影响"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2"
                                                  x:Name="RequireWebAccessKeyCheckBox"
                                                  IsChecked="{Binding Config.RequireWebAccessKey}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Style="{StaticResource ToggleSwitchStyle}"/>
                                    </Grid>

                                    <Grid Style="{StaticResource SettingRowStyle}"
                                          ToolTip="访问密钥会包含在复制的完整访问链接中，请不要发送给无关人员">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="录像网页访问密钥" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="保护开启时可全选复制；关闭保护后才能修改，修改后旧链接立即失效"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <TextBox Grid.Column="2"
                                                 x:Name="WebAccessKeyTextBox"
                                                 MaxLength="128"
                                                 Text="{Binding Config.WebAccessKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Setter Property="IsReadOnly" Value="False"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=RequireWebAccessKeyCheckBox, Path=IsChecked}" Value="True">
                                                            <Setter Property="IsReadOnly" Value="True"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowStyle}"
                                          ToolTip="缓存包含在线播放转码、剪辑预览图和剪辑下载文件，超出上限后会自动清理最旧文件">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="网页临时缓存上限" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="包含在线播放转码、剪辑预览和剪辑下载文件"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="更省空间" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ElementName=TranscodeCacheSlider, Path=Value, StringFormat={}{0:F0} MB}"
                                                           Style="{StaticResource SliderValueTextStyle}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="更多缓存" Style="{StaticResource SliderEndLabelStyle}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="TranscodeCacheSlider"
                                                    Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="128"
                                                    Maximum="2048"
                                                    TickFrequency="256"
                                                    Value="{Binding Config.TranscodeCacheMaxMB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource IntSliderValueConverter}}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Style="{StaticResource AdvancedSettingRowLastStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="调试日志" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="记录局域网服务和设备备份的详细信息"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2"
                                                  IsChecked="{Binding Config.EnableOrderInfoLog}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Style="{StaticResource ToggleSwitchStyle}"/>
                                    </Grid>

                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

<TabItem Header="扩展与联动"
         Visibility="{Binding Capabilities.CanRunWebServer, Converter={StaticResource BoolToVisibility}}">
    <Border Background="{StaticResource TransparentBrush}" Padding="0,4,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                            <Border Style="{StaticResource SectionCardStyle}"
                                    Visibility="{Binding Capabilities.IsRecordingDevice, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="安装订单联动" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="接收订单、备注和退款提醒"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="安装订单联动"
                                                Click="InstallTool_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                HorizontalAlignment="Left"/>
                                    </Grid>

                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="自定义订单脚本" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="导入第三方油猴脚本，导入后可在安装向导中选择"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="导入自定义脚本"
                                                Click="ImportUserscript_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                HorizontalAlignment="Left"/>
                                    </Grid>

                                    <Grid Style="{StaticResource SettingRowLastStyle}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}">
                                                <Run Text="已导入脚本（"/>
                                                <Run Text="{Binding CustomUserscripts.Count, Mode=OneWay}"/>
                                                <Run Text="）"/>
                                            </TextBlock>
                                            <TextBlock Text="可以删除不再使用的第三方脚本"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding CustomUserscripts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,16,0">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabelStyle}"/>
                                                            <TextBlock Style="{StaticResource FieldHintStyle}">
                                                                <Run Text="版本 "/>
                                                                <Run Text="{Binding Version}"/>
                                                                <Run Text=" · "/>
                                                                <Run Text="{Binding Author, TargetNullValue=未知作者}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Content="删除"
                                                                CommandParameter="{Binding}"
                                                                Click="RemoveUserscript_Click"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </StackPanel>
                            </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</TabItem>

            <TabItem Header="高级设置">
                <Border Background="{StaticResource TransparentBrush}" Padding="0,4,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 常规高级设置 -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="开机自启动" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="电脑开机后自动启动本程序"
                                                    Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="AutoStartCheckBox"
                                                Grid.Column="2"
                                                IsChecked="{Binding Config.AutoStartOnBoot}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource ToggleSwitchStyle}"/>
                                    </Grid>

                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="关闭窗口时" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="可以每次询问、最小化到托盘或直接退出"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2"
                                                  SelectedValue="{Binding Config.WindowCloseBehavior}"
                                                  SelectedValuePath="Tag">
                                            <ComboBoxItem Tag="Ask" Content="每次询问"/>
                                            <ComboBoxItem Tag="MinimizeToTray" Content="最小化到托盘"/>
                                            <ComboBoxItem Tag="Exit" Content="直接退出"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Style="{StaticResource SettingRowLastStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="自动检查更新" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="根目录启动器后台下载增量包，下次启动时自动安装"
                                                    Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2"
                                                IsChecked="{Binding Config.EnableAutoCheckUpdate}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource ToggleSwitchStyle}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 维护工具 -->
                            <Border Style="{StaticResource SectionCardStyle}"
                                    Visibility="{Binding Capabilities.CanUseCamera, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="配置向导" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="重新检查打包模式、摄像头、麦克风和可选扫码枪"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="重新运行"
                                                Click="RunSetupWizard_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                HorizontalAlignment="Left"/>
                                    </Grid>

                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="合并 MKV" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock x:Name="MigrationStatusText"
                                                       Text="扫描残留的 MKV 和 WAV，合并为 MP4"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <Button x:Name="BtnMigrateMkv"
                                                Grid.Column="2"
                                                Content="开始合并"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="BtnMigrateMkv_Click"/>
                                    </Grid>
                                    <ProgressBar x:Name="MigrationProgress"
                                                 Height="4"
                                                 Margin="0,-4,0,14"
                                                 Visibility="Collapsed"
                                                 IsIndeterminate="True"
                                                 Foreground="{DynamicResource AccentBlue}"/>

                                    <Grid Style="{StaticResource SettingRowLastStyle}"
                                        ToolTip="检测本机实时录制能力，并按摄像头原生模式推荐分辨率和帧率">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="检测并推荐录制规格" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="检测本机性能并推荐稳定的摄像头原生规格"
                                                    Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <Button x:Name="DetectRecordingProfileButton"
                                                Grid.Column="2"
                                                Content="开始检测"
                                                Click="DetectRecordingProfile_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                HorizontalAlignment="Left"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="关于">
                <Border Background="{StaticResource TransparentBrush}" Padding="0,4,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="84"
                                                Height="84"
                                                CornerRadius="14"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource ControlBackground}"
                                                BorderBrush="{DynamicResource BorderLight}"
                                                BorderThickness="1">
                                            <Image Source="{Binding AppIconImage, Mode=OneWay}"
                                                   Width="84"
                                                   Height="84"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="快递打包监控"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding AppVersion, Mode=OneWay, StringFormat=版本 {0}}"
                                                       Margin="0,5,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Text="{Binding AppBuildDate, Mode=OneWay}"
                                                       Margin="0,6,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding AppCommitText, Mode=OneWay}"
                                                       ToolTip="{Binding AppCommitToolTip, Mode=OneWay}"
                                                       Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Style="{StaticResource SettingRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="项目仓库" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="打开 GitHub 仓库，查看源码、发布记录和问题反馈"
                                                       Style="{StaticResource FieldHintStyle}"/>
                                        </StackPanel>
                                        <WrapPanel Grid.Column="2">
                                            <Button x:Name="CheckUpdateButton"
                                                    Content="检查更新"
                                                    Click="CheckUpdate_Click"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Margin="0,0,8,8"/>
                                            <Button Content="打开仓库"
                                                    Click="OpenRepository_Click"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Margin="0,0,8,8"/>
                                        </WrapPanel>
                                    </Grid>

                                    <Border Background="{DynamicResource ControlBackground}"
                                            BorderBrush="{DynamicResource BorderDefault}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="12"
                                                   LineHeight="19">
                                            <Run Text="本项目使用 AGPL-3.0 License 开源"/>
                                            <LineBreak/>
                                            <LineBreak/>
                                            <Run Text="个人学习、自家店铺自用可以免费使用"/>
                                            <LineBreak/>
                                            <Run Text="修改后对外分发或提供网络服务时，需要遵守 AGPL-3.0 的开源义务"/>
                                            <LineBreak/>
                                            <Run Text="二次修改分发时请保留原作者署名、版权声明和许可证信息"/>
                                            <LineBreak/>
                                            <Run Text="使用前请自行确认你的使用方式是否满足 AGPL-3.0 要求"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BorderLight}"
                BorderThickness="1,1,0,0"
                Padding="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <UniformGrid Grid.Column="1" Rows="1" Columns="3" Width="330">
                    <Button Content="确定" Margin="0,0,10,0" Click="BtnOk_Click" Style="{StaticResource SettingsFooterPrimaryButtonStyle}"/>
                    <Button Content="应用" Margin="0,0,10,0" Click="BtnApply_Click" Style="{StaticResource SettingsFooterSecondaryButtonStyle}"/>
                    <Button Content="取消" Click="BtnCancel_Click" Style="{StaticResource SettingsFooterSecondaryButtonStyle}"/>
                </UniformGrid>
            </Grid>
        </Border>

        <Border Grid.RowSpan="2"
                Background="{DynamicResource ToastBackground}"
                CornerRadius="8"
                Padding="28,14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Panel.ZIndex="1000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Setter Property="Opacity" Value="0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Context.ToastSource.IsToastVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Context.ToastSource.ToastMessage}"
                       Foreground="{StaticResource TextOnAccent}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       MaxWidth="620"/>
        </Border>
    </Grid>
</Window>
