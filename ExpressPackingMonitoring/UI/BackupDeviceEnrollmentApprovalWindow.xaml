<Window x:Class="ExpressPackingMonitoring.UI.BackupDeviceEnrollmentApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="允许设备连接？"
        SizeToContent="Height"
        Width="460"
        MaxHeight="620"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource TransparentBrush}"
        Foreground="{DynamicResource TextPrimary}"
        Closed="Window_Closed"
        KeyDown="Window_KeyDown">
    <Border Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource BorderDefault}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="38"
                        Height="38"
                        CornerRadius="12"
                        Background="{DynamicResource ControlBackground}">
                    <Path Width="20"
                          Height="20"
                          Data="{DynamicResource FluentWifiIcon}"
                          Fill="{DynamicResource AccentBlue}"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"
                           Text="允许设备连接？"
                           Foreground="{DynamicResource TextPrimary}"/>
            </Grid>

            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Margin="0,18,0,0"
                       TextWrapping="Wrap"
                       FontSize="14"
                       LineHeight="22"
                       Foreground="{DynamicResource TextPrimary}"/>

            <TextBlock Grid.Row="2"
                       Margin="0,10,0,0"
                       Text="60 秒内未处理，本次申请将自动取消"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"/>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0">
                <Button MinWidth="104"
                        Content="允许连接"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,10,0"
                        IsDefault="True"
                        Click="Approve_Click"/>
                <Button MinWidth="92"
                        Content="拒绝"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True"
                        Click="Deny_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
