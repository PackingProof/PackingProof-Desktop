<Window x:Class="ExpressPackingMonitoring.UI.ExtensionMarketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PackingProof 扩展市场"
        Width="920"
        Height="650"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="扩展市场" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="SourceStatusText"
                           Margin="0,5,0,0"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="正在读取经过签名的市场目录"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="InstallLocalButton"
                        Content="安装本地扩展"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,10,0"
                        Click="InstallLocal_Click"/>
                <Button x:Name="RefreshButton"
                        Content="刷新"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Refresh_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="8">
                <ListBox x:Name="CatalogList"
                         BorderThickness="0"
                         Background="{StaticResource TransparentBrush}"
                         Foreground="{DynamicResource TextPrimary}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="CatalogList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource TransparentBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlBackgroundHover}"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BadgePackBg}"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Badge}"
                                               Grid.Column="1"
                                               Margin="8,0,0,0"
                                               Foreground="{DynamicResource AccentOrange}"
                                               FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Summary}"
                                           Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding InstalledText}"
                                           Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource AccentBlue}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ExtensionNameText"
                                   Text="请选择一个扩展"
                                   FontSize="22"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="PublisherText"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                    <Border x:Name="RiskPanel"
                            Grid.Row="1"
                            Margin="0,16,0,0"
                            Padding="12"
                            CornerRadius="8"
                            Background="{DynamicResource WarningOverlay}"
                            Visibility="Collapsed">
                        <TextBlock x:Name="RiskText"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextOnAccent}"/>
                    </Border>
                    <ScrollViewer Grid.Row="2" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" LineHeight="22"/>
                            <TextBlock x:Name="VersionText"
                                       Margin="0,18,0,0"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="CompatibilityText"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock x:Name="InstallStatusText"
                                       Margin="0,12,0,0"
                                       Foreground="{DynamicResource AccentBlue}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,20,0,0">
                        <Button x:Name="InstallButton"
                                Content="安装"
                                MinWidth="92"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="False"
                                Click="Install_Click"/>
                        <Button x:Name="OpenFolderButton"
                                Content="打开目录"
                                MinWidth="92"
                                Margin="10,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="Collapsed"
                                Click="OpenFolder_Click"/>
                        <Button x:Name="RemoveButton"
                                Content="删除"
                                MinWidth="92"
                                Margin="10,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="Collapsed"
                                Click="Remove_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <ProgressBar x:Name="DownloadProgress"
                         Height="5"
                         VerticalAlignment="Center"
                         Visibility="Collapsed"/>
            <Button Content="关闭"
                    HorizontalAlignment="Right"
                    MinWidth="92"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
