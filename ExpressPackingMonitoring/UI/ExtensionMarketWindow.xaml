<Window x:Class="ExpressPackingMonitoring.UI.ExtensionMarketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PackingProof 扩展市场"
        Width="920"
        Height="650"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <Style x:Key="MarketMetadataTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style x:Key="MarketInstallStatusTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource MarketMetadataTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="已安装">
                    <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
                </Trigger>
                <Trigger Property="Text" Value="待更新">
                    <Setter Property="Foreground" Value="{DynamicResource AccentOrange}"/>
                </Trigger>
                <Trigger Property="Text" Value="下载中">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="扩展市场" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="SourceStatusText"
                           Margin="0,5,0,0"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="正在读取经过签名的市场目录"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="InstallLocalButton"
                        Content="安装本地扩展"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,10,0"
                        Click="InstallLocal_Click"/>
                <Button x:Name="RefreshButton"
                        Content="刷新"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Refresh_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="8">
                <ListBox x:Name="CatalogList"
                         BorderThickness="0"
                         Background="{StaticResource TransparentBrush}"
                         Foreground="{DynamicResource TextPrimary}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="CatalogList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource TransparentBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlBackgroundHover}"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BadgePackBg}"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Badge}"
                                           Grid.Column="1"
                                           Margin="8,0,0,0"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource AccentOrange}"
                                           FontSize="12"
                                           FontWeight="Normal"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Summary}"
                                           Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Margin="0,5,0,0"
                                           FontSize="12"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Summary}"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding AuthorText}"
                                           Grid.Row="2"
                                           Margin="0,5,0,0"
                                           Style="{StaticResource MarketMetadataTextStyle}"/>
                                <TextBlock Text="{Binding StatusText}"
                                           Grid.Row="2"
                                           Grid.Column="1"
                                           Margin="8,5,0,0"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource MarketInstallStatusTextStyle}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ExtensionNameText"
                                   Text="请选择一个扩展"
                                   FontSize="22"
                                   FontWeight="Bold"/>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock x:Name="PublisherText"
                                       Style="{StaticResource MarketMetadataTextStyle}"/>
                            <TextBlock x:Name="LatestVersionText"
                                       Margin="14,0,0,0"
                                       Style="{StaticResource MarketMetadataTextStyle}"/>
                            <TextBlock x:Name="InstalledVersionText"
                                       Margin="14,0,0,0"
                                       Style="{StaticResource MarketMetadataTextStyle}"/>
                        </WrapPanel>
                        <TextBlock x:Name="CompatibilityText"
                                   Margin="0,6,0,0"
                                   Style="{StaticResource MarketMetadataTextStyle}"/>
                    </StackPanel>
                    <Border x:Name="RiskPanel"
                            Grid.Row="1"
                            Margin="0,16,0,0"
                            Padding="12"
                            CornerRadius="8"
                            Background="{DynamicResource WarningOverlay}"
                            Visibility="Collapsed">
                        <TextBlock x:Name="RiskText"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextOnAccent}"/>
                    </Border>
                    <ScrollViewer Grid.Row="2" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" LineHeight="22"/>
                        </StackPanel>
                    </ScrollViewer>
                    <WrapPanel Grid.Row="3" Margin="0,20,0,0">
                        <Button x:Name="InstallButton"
                                Content="安装"
                                MinWidth="92"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="False"
                                Click="Install_Click"/>
                        <Button x:Name="InstallOtherVersionButton"
                                Content="安装其他版本"
                                MinWidth="118"
                                Margin="10,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                IsEnabled="False"
                                Click="InstallOtherVersion_Click"/>
                        <Button x:Name="OpenFolderButton"
                                Content="打开目录"
                                MinWidth="92"
                                Margin="10,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="Collapsed"
                                Click="OpenFolder_Click"/>
                        <Button x:Name="RemoveButton"
                                Content="删除"
                                MinWidth="92"
                                Margin="10,0,0,0"
                                Style="{StaticResource DeleteButtonStyle}"
                                Visibility="Collapsed"
                                Click="Remove_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="DownloadProgressPanel"
                  Margin="0,0,20,0"
                  VerticalAlignment="Center"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DownloadStatusText"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="DownloadProgressText"
                               Grid.Column="1"
                               Margin="16,0,0,0"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextSecondary}"/>
                </Grid>
                <ProgressBar x:Name="DownloadProgress"
                             Grid.Row="1"
                             Height="6"
                             Margin="0,7,0,0"
                             Background="{DynamicResource ControlBackground}"
                             Foreground="{DynamicResource AccentBlue}"/>
            </Grid>
            <Button Grid.Column="1"
                    Content="关闭"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    MinWidth="92"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
