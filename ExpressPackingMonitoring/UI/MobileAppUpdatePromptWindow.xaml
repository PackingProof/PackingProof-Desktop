<Window x:Class="ExpressPackingMonitoring.UI.MobileAppUpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手机 App 更新"
        Width="440"
        SizeToContent="Height"
        MaxHeight="620"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimary}"
        AutomationProperties.Name="手机 App 更新提示">
    <Border Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource BorderDefault}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="38"
                        Height="38"
                        CornerRadius="12"
                        Background="{DynamicResource ControlBackground}">
                    <Path Width="20"
                          Height="20"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="{StaticResource FluentPhoneIcon}"
                          Fill="{DynamicResource AccentBlue}"/>
                </Border>
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Text="发现新版手机 App"
                           Foreground="{DynamicResource TextPrimary}"/>
            </Grid>
            <ScrollViewer Grid.Row="1"
                          Margin="0,18,0,0"
                          MaxHeight="430"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText"
                           TextWrapping="Wrap"
                           FontSize="14"
                           LineHeight="22"
                           Foreground="{DynamicResource TextPrimary}"/>
            </ScrollViewer>
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0">
                <Button MinWidth="92"
                        Content="前往下载"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,10,0"
                        IsDefault="False"
                        Click="DownloadButton_Click"/>
                <Button MinWidth="92"
                        Content="稍后"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True"
                        Click="LaterButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
