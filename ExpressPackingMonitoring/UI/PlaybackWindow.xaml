<Window x:Class="ExpressPackingMonitoring.UI.PlaybackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="历史录像检索与回放" Height="700" Width="1100" MinHeight="560" MinWidth="920"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}"
        Icon="/app.ico"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="MainGrid" Width="44" Height="24" VerticalAlignment="Center">
                            <Border x:Name="BorderUnchecked" CornerRadius="12" Background="{DynamicResource BorderStrong}"/>
                            <Border x:Name="BorderChecked" CornerRadius="12" Background="{DynamicResource AccentBlue}" Opacity="0"/>
                            <Ellipse x:Name="Knob" Width="20" Height="20" Fill="{StaticResource TextOnAccent}" HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.2" Direction="270"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="20" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="BorderChecked"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="BorderChecked"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MainGrid"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.8" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MainGrid"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*" MinWidth="540"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" CornerRadius="8" Padding="15" Margin="0,0,15,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Path Data="{StaticResource FluentCalendarIcon}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
                        <TextBlock Text="录像日期范围:" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DatePicker x:Name="DpStartDate" Grid.Column="0" SelectedDateChanged="DateFilterChanged"/>
                        <TextBlock Grid.Column="1" Text="至" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <DatePicker x:Name="DpEndDate" Grid.Column="2" SelectedDateChanged="DateFilterChanged"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Path Data="{StaticResource FluentSearchIcon}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
                        <TextBlock Text="单号精准搜索:" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                    <Grid>
                        <TextBox x:Name="SearchBox" FontSize="14" Padding="5,5,28,5" TextChanged="TextFilterChanged" BorderBrush="{DynamicResource AccentBlueDark}" BorderThickness="2"/>
                        <Button Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Cursor="Hand" Foreground="{DynamicResource TextMuted}" Background="{StaticResource TransparentBrush}" BorderThickness="0" Focusable="False" Click="BtnClearSearch_Click">
                            <Path Data="{StaticResource FluentDismissIcon}" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource TextMuted}"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="11">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="HideUnavailableButton"
                                Grid.Column="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="HideUnavailableButton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path x:Name="HideUnavailableButtonIcon"
                                      Data="{StaticResource FluentEyeOffIcon}"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      Fill="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Margin="0,0,7,0"/>
                                <TextBlock x:Name="HideUnavailableButtonText" Text="显示清理记录"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnImportVideos"
                                Grid.Column="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnImportVideos_Click"
                                Visibility="Collapsed"
                                AutomationProperties.Name="导入录像">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource FluentFolderIcon}"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      Fill="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Margin="0,0,7,0"/>
                                <TextBlock Text="导入录像"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="HiddenHintPanel"
                                Orientation="Horizontal"
                                Margin="0,10,0,0"
                                Visibility="Collapsed">
                        <Path Data="{StaticResource FluentDismissIcon}"
                              Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Fill="{DynamicResource TextSecondary}"
                              Margin="0,0,5,0"
                              VerticalAlignment="Center"/>
                        <TextBlock x:Name="HiddenHintText"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ListView x:Name="VideoList" Grid.Row="1" FontSize="14" SelectionChanged="VideoList_SelectionChanged" BorderThickness="0" Background="{StaticResource TransparentBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.05" Direction="270"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="ModeStrip" Grid.Column="0" Margin="0,10,0,10" CornerRadius="0,4,4,0" Background="{DynamicResource AccentBlue}"/>
                                                <ContentPresenter Grid.Column="1" Margin="12,10"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                                <Setter Property="Background" Value="{DynamicResource ControlBackgroundHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                                <Setter Property="Background" Value="{DynamicResource BadgePackBg}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Mode}" Value="退货">
                                                <Setter TargetName="ModeStrip" Property="Background" Value="{DynamicResource AccentOrange}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                                <Setter TargetName="ModeStrip" Property="Opacity" Value="0.45"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding DisplayName}" FontWeight="Medium" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Duration}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding FileSize}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding EncoderDisplay}" FontSize="11" Foreground="{DynamicResource AccentBlue}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding SourceDisplay}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding StopReason}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,8,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentRed}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentRed}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsStoredOnHost}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsArchiveWarning}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentRed}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PageStatusText"
                               Grid.Row="0"
                               Margin="0,0,0,6"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="NoWrap"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnPreviousPage" Grid.Column="0" Content="上一页" Style="{StaticResource SecondarySmallButtonStyle}" Click="BtnPreviousPage_Click"/>
                        <Button x:Name="BtnNextPage" Grid.Column="2" Content="下一页" Style="{StaticResource SecondarySmallButtonStyle}" Click="BtnNextPage_Click"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="PlayerHost" Grid.Column="1" Background="{DynamicResource PanelBackground}" CornerRadius="8" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. 播放器填满可用区域，由 LibVLC 保持录像原始比例 -->
                <Grid x:Name="VideoArea" Grid.Row="0" Background="{DynamicResource VideoSurfaceBackground}">
                    <vlc:VideoView x:Name="PlayerView"
                                   Background="{DynamicResource VideoSurfaceBackground}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch">
                        <Border x:Name="PlaybackCover"
                                Background="{DynamicResource PanelBackground}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Path Data="{StaticResource FluentPlayIcon}"
                                      Width="36"
                                      Height="36"
                                      Stretch="Uniform"
                                      Fill="{DynamicResource TextMuted}"
                                      HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PlaybackCoverText"
                                           Text="请选择录像开始播放"
                                           Margin="0,12,0,0"
                                           Foreground="{DynamicResource TextSecondary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </vlc:VideoView>
                </Grid>

                <!-- 2. 控制条放在第 1 行 -->
                <Border Grid.Row="1" Background="{DynamicResource ToastBackground}" Padding="15,10" Panel.ZIndex="99">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnTogglePlay" Grid.Column="0" Height="32" Style="{StaticResource PrimaryButtonStyle}" Click="BtnTogglePlay_Click" ToolTip="播放" Margin="0,0,15,0">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="PlayStateIcon" Data="{StaticResource FluentPlayIcon}" Width="15" Height="15" Stretch="Uniform" Fill="{StaticResource TextOnAccent}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="PlayStateText" Text="播放"/>
                            </StackPanel>
                        </Button>

                        <Slider x:Name="TimelineSlider" Grid.Column="1" MinWidth="120" VerticalAlignment="Center" Minimum="0"
                                Thumb.DragStarted="TimelineSlider_DragStarted" 
                                Thumb.DragCompleted="TimelineSlider_DragCompleted" 
                                ValueChanged="TimelineSlider_ValueChanged"/>

                        <TextBlock x:Name="TimeLabel" Grid.Column="2" MinWidth="145" Text="00:00:00 / 00:00:00" Foreground="{StaticResource TextOnAccent}" VerticalAlignment="Center" Margin="15,0,0,0" FontFamily="Consolas"/>

                        <Button x:Name="BtnLocateFile" Grid.Column="3" Height="32" Style="{StaticResource PrimaryButtonStyle}" Click="BtnLocateFile_Click" Margin="15,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource FluentFolderIcon}" Width="15" Height="15" Stretch="Uniform" Fill="{StaticResource TextOnAccent}" Margin="0,0,6,0"/>
                                <TextBlock Text="定位文件"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>


