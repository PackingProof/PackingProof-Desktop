                                               Text="{Binding OrderIntegrationStatusText, Mode=OneWay}"
                                               Margin="6,4,0,0"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="4" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Button x:Name="BtnSwitchWorkstation"
                                        Grid.Column="0"
                                        Height="32"
                                        Padding="9,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="切换用途"
                                        Cursor="Hand"
                                        Focusable="False"
                                        IsEnabled="{Binding CanSwitchWorkstation}">
                                    <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                        <Path Data="{StaticResource FluentArrowSwapIcon}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        <TextBlock Text="{Binding SwitchWorkstationButtonText}" Margin="5,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnMobileConnection"
                                        Grid.Column="2"
                                        Height="32"
                                        Padding="9,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Visibility="{Binding IsMainConnectionVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="{Binding MainConnectionButtonToolTip, Mode=OneWay}"
                                        Focusable="False">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" IsHitTestVisible="False">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource TextOnAccent}">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Data" Value="{StaticResource FluentWifiIcon}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRecordingWorkstation, Mode=OneWay}" Value="True">
                                                            <Setter Property="Data" Value="{StaticResource FluentDatabaseIcon}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Text="{Binding MainConnectionButtonText, Mode=OneWay}"
                                                   Margin="5,0,0,0"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextOnAccent}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnInstallUserscript"
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Height="32"
                                        Padding="9,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="打开订单联动插件安装向导"
                                        Focusable="False">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" IsHitTestVisible="False">
                                        <Path Data="{StaticResource FluentIntegrationIcon}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        <TextBlock Text="{Binding UserscriptButtonText, Mode=OneWay}" Margin="5,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnSendTestOrder"
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Height="32"
                                        Padding="9,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="向当前在线的全部录像设备发送测试订单"
                                        Focusable="False">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" IsHitTestVisible="False">
                                        <Path Data="{StaticResource FluentBroadcastIcon}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        <TextBlock x:Name="SendTestOrderButtonText" Text="发送测试订单" Margin="5,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 行2条形码: 开录/停录 -->
                    <Border Grid.Row="4" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,6,0,0">
                        <Grid Height="60">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Barcode2Label}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextAlignment="Center" Width="20" LineHeight="18" Margin="0,0,4,0"/>
                            <Grid Grid.Column="1">
                                <Image Source="{Binding Barcode2Image}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="12,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Barcode2Image}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="条码冷却中…" FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Barcode2CooldownProgress}" Foreground="{DynamicResource AccentBlue}" Background="{DynamicResource BorderStrong}" BorderThickness="0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Background="{DynamicResource ToastBackground}" CornerRadius="8" Padding="32,16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Panel.ZIndex="1000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsToastVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <Path Width="20"
                      Height="20"
                      Margin="0,0,10,0"
                      Stretch="Uniform"
                      VerticalAlignment="Center">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="{StaticResource FluentCheckIcon}"/>
                            <Setter Property="Fill" Value="{DynamicResource AccentGreen}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastSeverity}" Value="Warning">
                                    <Setter Property="Data" Value="{StaticResource FluentWarningIcon}"/>
                                    <Setter Property="Fill" Value="{DynamicResource AccentOrange}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ToastSeverity}" Value="Error">
                                    <Setter Property="Data" Value="{StaticResource FluentDismissIcon}"/>
                                    <Setter Property="Fill" Value="{DynamicResource AccentRed}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ToastSeverity}" Value="Information">
                                    <Setter Property="Data" Value="{StaticResource FluentInfoIcon}"/>
                                    <Setter Property="Fill" Value="{DynamicResource AccentBlue}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <TextBlock Text="{Binding ToastMessage}"
                           Foreground="{StaticResource TextOnAccent}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>


