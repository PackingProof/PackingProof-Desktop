<Window x:Class="ExpressPackingMonitoring.UI.FloatingPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="clr-namespace:ExpressPackingMonitoring.Localization"
        xmlns:ui="clr-namespace:ExpressPackingMonitoring.UI"
        Title="PackingProof"
        Width="340" Height="248"
        MinWidth="260" MinHeight="196"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{StaticResource TransparentBrush}"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <localization:LocalizedTextConverter x:Key="LocalizedTextConverter"/>

        <!-- 圆角图标按钮，沿用主界面 ModernBtn 的 8 圆角与悬停减淡手法 -->
        <Style x:Key="FloatingGlassButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="{StaticResource CameraPreviewOverlayButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CameraPreviewOverlayButtonBorder}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                UseLayoutRounding="True"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 图标统一按 24 单位画布的一半渲染，整数倍缩放才不会发虚 -->
        <Style x:Key="FloatingGlassIcon" TargetType="Path">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Fill" Value="{StaticResource CameraPreviewOverlayButtonText}"/>
            <Setter Property="UseLayoutRounding" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="False"/>
        </Style>

    </Window.Resources>

    <!-- 外层 10 圆角与主界面面板一致 -->
    <Border x:Name="RootBorder"
            CornerRadius="10"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource BorderStrong}"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 与主窗口绑定同一个 VideoFrame，不复制帧也不改变采集逻辑 -->
            <Border x:Name="PreviewSurface"
                    Grid.Row="0"
                    CornerRadius="9,9,0,0"
                    Background="{StaticResource VideoSurfaceBackground}">
                <!-- 用与圆角一致的裁剪，缩小到画面铺满时视频的直角才不会顶出圆角 -->
                <Grid x:Name="PreviewClipHost" ui:RoundedClip.Radius="9,9,0,0">
                    <Image Source="{Binding VideoFrame}" Stretch="Uniform"/>

                    <!-- 悬停才显示控制层；不加蒙版，避免遮挡监控画面 -->
                    <Grid x:Name="ControlLayer" Visibility="Collapsed">
                        <!-- 左上：回到主界面 -->
                        <Button x:Name="RestoreButton"
                                Style="{StaticResource FloatingGlassButton}"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                Click="RestoreButton_Click">
                            <Path Style="{StaticResource FloatingGlassIcon}" Data="{StaticResource FluentReturnIcon}"/>
                        </Button>

                        <!-- 右上：直接关掉小窗，不回主界面 -->
                        <Button x:Name="CloseButton"
                                Style="{StaticResource FloatingGlassButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                Click="CloseButton_Click">
                            <Path Style="{StaticResource FloatingGlassIcon}" Data="{StaticResource FluentDismissIcon}"/>
                        </Button>

                        <!-- 左下：选择麦克风 -->
                        <Button x:Name="MicrophoneButton"
                                Style="{StaticResource FloatingGlassButton}"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                                Click="MicrophoneButton_Click">
                            <Path Style="{StaticResource FloatingGlassIcon}" Data="{StaticResource FluentMicrophoneIcon}"/>
                        </Button>

                        <!-- 右下：选择播报喇叭 -->
                        <Button x:Name="SpeakerButton"
                                Style="{StaticResource FloatingGlassButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                Click="SpeakerButton_Click">
                            <Path Style="{StaticResource FloatingGlassIcon}" Data="{StaticResource FluentSpeakerIcon}"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- 状态条：状态灯与文案由 FloatingPreviewStatusPolicy 决定 -->
            <!-- 底部两角必须自己带圆角，否则会盖住外层圆角，露出方角并吃掉边框 -->
            <!-- 流光铺满整条并用负外边距顶到边缘，所以裁剪要用圆角几何，不能只靠 ClipToBounds -->
            <Border Grid.Row="1"
                    x:Name="StatusBar"
                    Padding="10,8"
                    CornerRadius="0,0,9,9"
                    ui:RoundedClip.Radius="0,0,9,9"
                    Background="{DynamicResource ControlBackground}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!--
                        流光层：与主界面录制卡片一致，铺满整条状态区（含单号）而不是画成进度条。
                        负外边距抵掉 Border 的 Padding，让流光扫过整条而不是只扫内容区。
                    -->
                    <Rectangle x:Name="ShimmerLayer"
                               Grid.Row="0" Grid.RowSpan="2"
                               Margin="-10,-8"
                               Visibility="Collapsed"
                               IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <LinearGradientBrush.RelativeTransform>
                                    <TranslateTransform x:Name="ShimmerTransform" X="-1"/>
                                </LinearGradientBrush.RelativeTransform>
                                <GradientStop Color="{StaticResource TransparentColor}" Offset="0"/>
                                <GradientStop Color="{StaticResource RecordingShimmerEdgeColor}" Offset="0.3"/>
                                <GradientStop Color="{StaticResource RecordingShimmerCoreColor}" Offset="0.5"/>
                                <GradientStop Color="{StaticResource RecordingShimmerEdgeColor}" Offset="0.7"/>
                                <GradientStop Color="{StaticResource TransparentColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="StatusDot" Grid.Column="0"
                                 Width="9" Height="9" Margin="1,0,8,0"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource TextMuted}"/>

                        <TextBlock x:Name="StatusText" Grid.Column="1"
                                   Text="{Binding FloatingPreviewStatusText}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- 发货/退货徽标，点击切换模式，复用主界面的 ToggleModeCommand -->
                        <!-- 右边距要给右下角的缩放手柄让位，否则两者叠在一起点不准 -->
                        <Button x:Name="ModeButton" Grid.Column="2"
                                Command="{Binding ToggleModeCommand}"
                                Cursor="Hand"
                                Focusable="False"
                                Margin="8,0,14,0"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ModeBadge"
                                            Background="{DynamicResource BadgePackBg}"
                                            CornerRadius="4"
                                            Padding="7,2"
                                            SnapsToDevicePixels="True">
                                        <TextBlock x:Name="ModeText"
                                                   Text="{Binding CurrentMode, Converter={StaticResource LocalizedTextConverter}}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BadgePackText}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding CurrentMode}" Value="退货">
                                            <Setter TargetName="ModeBadge" Property="Background" Value="{DynamicResource BadgeReturnBg}"/>
                                            <Setter TargetName="ModeText" Property="Foreground" Value="{DynamicResource BadgeReturnText}"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ModeBadge" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- 设备切换等即时反馈：主窗口已最小化，Toast 看不见，只能在小窗里就地提示 -->
                    <Border x:Name="InlineNoticeBorder"
                            Grid.Row="1"
                            Visibility="Collapsed"
                            Margin="0,6,0,0"
                            Background="{DynamicResource ControlBackgroundHover}"
                            CornerRadius="4"
                            Padding="7,3"
                            HorizontalAlignment="Stretch">
                        <TextBlock x:Name="InlineNoticeText"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
