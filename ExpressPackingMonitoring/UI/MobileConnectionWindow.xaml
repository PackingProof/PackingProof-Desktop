<Window x:Class="ExpressPackingMonitoring.UI.MobileConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手机/电脑连接"
        Width="976"
        SizeToContent="Height"
        MaxHeight="740"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}"
        Foreground="{DynamicResource TextPrimary}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
            <Grid Grid.IsSharedSizeScope="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="16"
                        CornerRadius="12"
                        Background="{DynamicResource ControlBackground}"
                        BorderBrush="{DynamicResource BorderDefault}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" SharedSizeGroup="ConnectionCardTitle"/>
                            <RowDefinition Height="Auto" SharedSizeGroup="ConnectionCardDescription"/>
                            <RowDefinition Height="Auto" SharedSizeGroup="ConnectionCardQr"/>
                            <RowDefinition Height="*" SharedSizeGroup="ConnectionCardDetails"/>
                            <RowDefinition Height="Auto" SharedSizeGroup="ConnectionCardActions"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource FluentPhoneIcon}"
                                  Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource AccentBlue}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="连接录像网页"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="手机或其他电脑连接同一个局域网后，扫描二维码即可打开录像"
                                   Margin="0,4,0,0"
                                   MinHeight="36"
                                   FontSize="12"
                                   LineHeight="18"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <Grid x:Name="ReadyPanel"
                              Grid.Row="2"
                              Grid.RowSpan="3"
                              Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="232"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border HorizontalAlignment="Center"
                                    Width="232"
                                    Height="232"
                                    Padding="10"
                                    CornerRadius="10"
                                    Background="{StaticResource QrCodeBackground}"
                                    BorderBrush="{DynamicResource BorderDefault}"
                                    BorderThickness="1">
                                <Image x:Name="QrCodeImage"
                                       Width="210"
                                       Height="210"
                                       Stretch="Uniform"
                                       SnapsToDevicePixels="True"
                                       AutomationProperties.Name="录像网页连接二维码"/>
                            </Border>

                            <StackPanel Grid.Row="1">
                                <TextBlock Text="访问网址"
                                           Margin="0,10,0,5"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBox x:Name="AccessUrlTextBox"
                                         IsReadOnly="True"
                                         TextWrapping="NoWrap"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Center"
                                         Padding="9,7"
                                         AutomationProperties.Name="录像网页访问网址"/>
                                <TextBlock x:Name="SecurityNotice"
                                           Text="此网址包含录像访问密钥，请不要发送给无关人员"
                                           Margin="0,8,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource AccentOrange}"
                                           Visibility="Collapsed"/>
                            </StackPanel>

                            <WrapPanel Grid.Row="2"
                                       HorizontalAlignment="Right"
                                       Margin="0,10,0,0">
                                <Button x:Name="CopyButton"
                                        Content="复制网址"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,0"
                                        AutomationProperties.Name="复制录像网页网址"
                                        Click="Copy_Click"/>
                                <Button x:Name="OpenButton"
                                        Content="电脑打开"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        AutomationProperties.Name="在电脑打开录像网页"
                                        Click="Open_Click"/>
                            </WrapPanel>
                        </Grid>

                        <Border x:Name="UnavailablePanel"
                                Grid.Row="2"
                                Grid.RowSpan="3"
                                Margin="0,10,0,0"
                                Padding="14"
                                CornerRadius="8"
                                Background="{DynamicResource PanelBackground}"
                                BorderBrush="{DynamicResource BorderDefault}"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="暂时无法生成连接二维码"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="UnavailableText"
                                           Margin="0,7,0,0"
                                           FontSize="12"
                                           LineHeight="18"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <Button x:Name="OpenSettingsButton"
                                        Content="打开设置"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Visibility="Collapsed"
                                        Click="OpenSettings_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Padding="16"
                        CornerRadius="12"
                        Background="{DynamicResource ControlBackground}"
                        BorderBrush="{DynamicResource BorderDefault}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" SharedSizeGroup="ConnectionCardTitle"/>
                            <RowDefinition Height="Auto" SharedSizeGroup="ConnectionCardDescription"/>
                            <RowDefinition Height="Auto" SharedSizeGroup="ConnectionCardQr"/>
                            <RowDefinition Height="*" SharedSizeGroup="ConnectionCardDetails"/>
                            <RowDefinition Height="Auto" SharedSizeGroup="ConnectionCardActions"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource AndroidIcon}"
                                  Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource AccentBlue}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="下载手机 App"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="使用 Android 手机扫码，下载 PackingProof 手机录像 App"
                                   Margin="0,4,0,0"
                                   MinHeight="36"
                                   FontSize="12"
                                   LineHeight="18"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <Border Grid.Row="2"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0"
                                Width="232"
                                Height="232"
                                Padding="10"
                                CornerRadius="10"
                                Background="{StaticResource QrCodeBackground}"
                                BorderBrush="{DynamicResource BorderDefault}"
                                BorderThickness="1">
                            <Image x:Name="MobileAppQrCodeImage"
                                   Width="210"
                                   Height="210"
                                   Stretch="Uniform"
                                   SnapsToDevicePixels="True"
                                   AutomationProperties.Name="手机 App 下载二维码"/>
                        </Border>

                        <StackPanel Grid.Row="3">
                            <TextBlock x:Name="MobileAppVersionText"
                                       Text="Android 版 · 扫码打开下载页"
                                       Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="下载完成后按手机提示安装，再扫描左侧二维码连接这台电脑"
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       LineHeight="18"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>

                        <WrapPanel Grid.Row="4"
                                   HorizontalAlignment="Right"
                                   Margin="0,10,0,0">
                            <Button x:Name="CopyMobileAppUrlButton"
                                    Content="复制网址"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,0"
                                    AutomationProperties.Name="复制手机 App 下载网址"
                                    Click="CopyMobileAppUrl_Click"/>
                            <Button x:Name="OpenMobileAppDownloadButton"
                                    Content="电脑打开"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    AutomationProperties.Name="在电脑打开手机 App 下载页"
                                    Click="OpenMobileAppDownload_Click"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="4"
                        Padding="16"
                        CornerRadius="12"
                        Background="{DynamicResource ControlBackground}"
                        BorderBrush="{DynamicResource BorderDefault}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" SharedSizeGroup="ConnectionCardTitle"/>
                            <RowDefinition Height="Auto" SharedSizeGroup="ConnectionCardDescription"/>
                            <RowDefinition Height="Auto" SharedSizeGroup="ConnectionCardQr"/>
                            <RowDefinition Height="*" SharedSizeGroup="ConnectionCardDetails"/>
                            <RowDefinition Height="Auto" SharedSizeGroup="ConnectionCardActions"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource AppleIcon}"
                                  Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource AccentBlue}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="iOS 内测"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="扫码加入内测"
                                   Margin="0,4,0,0"
                                   MinHeight="36"
                                   FontSize="12"
                                   LineHeight="18"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <Border Grid.Row="2"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0"
                                Width="232"
                                Height="232"
                                Padding="10"
                                CornerRadius="10"
                                Background="{StaticResource QrCodeBackground}"
                                BorderBrush="{DynamicResource BorderDefault}"
                                BorderThickness="1">
                            <Image x:Name="TestFlightQrCodeImage"
                                   Width="210"
                                   Height="210"
                                   Stretch="Uniform"
                                   SnapsToDevicePixels="True"
                                   AutomationProperties.Name="iOS 内测二维码"/>
                        </Border>

                        <StackPanel Grid.Row="3">
                            <TextBlock Text="iOS 内测 · TestFlight 扫码加入"
                                       Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>

                        <WrapPanel Grid.Row="4"
                                   HorizontalAlignment="Right"
                                   Margin="0,10,0,0">
                            <Button x:Name="CopyTestFlightUrlButton"
                                    Content="复制网址"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,0"
                                    AutomationProperties.Name="复制 TestFlight 加入网址"
                                    Click="CopyTestFlightUrl_Click"/>
                            <Button x:Name="OpenTestFlightButton"
                                    Content="电脑打开"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    AutomationProperties.Name="在电脑打开 TestFlight 加入页"
                                    Click="OpenTestFlight_Click"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </ScrollViewer>
</Window>
