<Window x:Class="ExpressPackingMonitoring.UI.ExtensionEnrollmentApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="允许第三方扩展连接？"
        SizeToContent="Height"
        Width="520"
        MaxHeight="720"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource TransparentBrush}"
        Foreground="{DynamicResource TextPrimary}"
        Closed="Window_Closed"
        KeyDown="Window_KeyDown">
    <Border Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource BorderDefault}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="12"
                        Background="{DynamicResource ControlBackground}">
                    <Path Width="20" Height="20"
                          Data="{DynamicResource FluentIntegrationIcon}"
                          Fill="{DynamicResource AccentBlue}"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"
                           Text="允许第三方扩展连接？"/>
            </Grid>

            <TextBlock x:Name="IdentityText"
                       Grid.Row="1"
                       Margin="0,18,0,0"
                       TextWrapping="Wrap"
                       FontSize="14"
                       LineHeight="22"/>

            <Border Grid.Row="2"
                    Margin="0,14,0,0"
                    Padding="14"
                    CornerRadius="10"
                    Background="{DynamicResource ControlBackground}">
                <StackPanel>
                    <TextBlock Text="申请访问范围"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <ItemsControl x:Name="AccessItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           TextWrapping="Wrap"
                                           Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="RoutingText"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="3"
                       Margin="0,12,0,0"
                       Text="PackingProof 不会执行此扩展的代码。允许后，扩展只能调用上面列出的接口；请仅批准你信任的来源"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"/>

            <TextBlock x:Name="CountdownText"
                       Grid.Row="4"
                       Margin="0,10,0,0"
                       Text="60 秒内未处理，本次申请将自动取消"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"/>

            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0">
                <Button MinWidth="112"
                        Content="允许扩展"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,10,0"
                        Click="Approve_Click"/>
                <Button MinWidth="92"
                        Content="拒绝"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True"
                        Click="Deny_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
