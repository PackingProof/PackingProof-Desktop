<Window x:Class="ExpressPackingMonitoring.UI.FirstUseSetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ExpressPackingMonitoring.UI.Controls"
        Title="电脑录像配置向导"
        Height="690"
        Width="920"
        MinHeight="660"
        MinWidth="860"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/app.ico"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <!-- 字号沿用向导原来的大小（22 号标题等），只把间距按设置页的节奏收紧过 -->
        <Style x:Key="WizardPageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="WizardPageHintStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,16"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <Style x:Key="WizardOptionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="WizardOptionHintStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <Style x:Key="WizardCardButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Padding="16"
                                Background="{DynamicResource PanelBackground}"
                                BorderBrush="{DynamicResource BorderDefault}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="18"
                                      Height="18"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Ellipse x:Name="Outer"
                                             Stroke="{DynamicResource BorderStrong}"
                                             StrokeThickness="2"/>
                                    <Ellipse x:Name="Inner"
                                             Width="8"
                                             Height="8"
                                             Fill="{DynamicResource AccentBlue}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Opacity="0"/>
                                </Grid>
                                <ContentPresenter Grid.Column="2"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BorderLight}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource AccentBlue}"/>
                                <Setter TargetName="Inner" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- 与设置页“单号判断规则”等输入框保持同一套主题样式 -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BorderLight}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CameraPreviewOverlayButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{DynamicResource CameraPreviewOverlayButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CameraPreviewOverlayButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource CameraPreviewOverlayButtonText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="32" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 每个步骤卡片自己带标题，窗口级的大标题+副标题只会白占卡片高度，这里不再重复 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource ControlBackground}"
                    BorderBrush="{DynamicResource BorderLight}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">
                <StackPanel>
                    <TextBlock x:Name="StepModeText" Text="1. 选择打包模式" Style="{StaticResource StepTextStyle}"/>
                    <TextBlock x:Name="StepCameraText" Text="2. 选择摄像头" Style="{StaticResource StepTextStyle}"/>
                    <TextBlock x:Name="StepCameraRecognitionText" Text="3. 摄像头识别" Style="{StaticResource StepTextStyle}"/>
                    <TextBlock x:Name="StepRecordingProfileText" Text="4. 录制性能检测" Style="{StaticResource StepTextStyle}"/>
                    <TextBlock x:Name="StepMicText" Text="5. 选择麦克风" Style="{StaticResource StepTextStyle}"/>
                    <TextBlock x:Name="StepScannerText" Text="6. 扫码枪（可选）" Style="{StaticResource StepTextStyle}"/>
                    <TextBlock x:Name="StepDoneText" Text="7. 完成" Style="{StaticResource StepTextStyle}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource BorderLight}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <Grid>
                    <Grid x:Name="ModePage">
                        <StackPanel>
                            <TextBlock Text="选择打包模式"
                                       Style="{StaticResource WizardPageTitleStyle}"/>
                            <TextBlock Text="推荐连续打包模式，识别或扫描下一张面单时自动保存上一单"
                                       Style="{StaticResource WizardPageHintStyle}"/>
                            <RadioButton x:Name="ContinuousModeRadio"
                                         GroupName="PackingMode"
                                         IsChecked="True"
                                         Style="{StaticResource WizardCardButtonStyle}">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="连续打包模式"
                                                   FontSize="18"
                                                   FontWeight="Black"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <Border Margin="10,0,0,0"
                                                Padding="8,3"
                                                Background="{DynamicResource AccentBlue}"
                                                CornerRadius="6">
                                            <TextBlock Text="推荐" Foreground="{StaticResource TextOnAccent}" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="识别或扫描下一张面单条码后，自动结束上一单并开始下一单"
                                               Style="{StaticResource WizardOptionHintStyle}"
                                               FontSize="14"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="SameCodeModeRadio"
                                         GroupName="PackingMode"
                                         Style="{StaticResource WizardCardButtonStyle}">
                                <StackPanel>
                                    <TextBlock Text="同码停录模式"
                                                   FontSize="18"
                                                   FontWeight="Black"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="识别或扫描面单条码开始录制，再次识别同一条码停止录制"
                                               Style="{StaticResource WizardOptionHintStyle}"
                                               FontSize="14"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="CameraPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- 摄像头标题压成下拉框左边的一行，标题与副标题不再占用预览画面 -->
                        <StackPanel Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="选择摄像头"
                                           Margin="0,0,10,0"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <ComboBox x:Name="CameraComboBox"
                                          Grid.Column="1"
                                          Height="36"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="CameraComboBox_SelectionChanged"/>
                                <Button x:Name="NetworkCameraTestButton"
                                        Grid.Column="2"
                                        Content="测试连接"
                                        Height="36"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"
                                        Style="{StaticResource SecondarySmallButtonStyle}"
                                        Click="NetworkCameraTestButton_Click"/>
                            </Grid>
                            <StackPanel x:Name="NetworkCameraPanel"
                                        Visibility="Collapsed"
                                        Margin="0,8,0,0">
                                <Grid>
                                    <TextBox x:Name="NetworkCameraUrlTextBox"
                                             TextChanged="NetworkCameraUrlTextBox_TextChanged"
                                             ToolTip="rtsp://user:password@192.168.1.64:554/stream"/>
                                    <TextBlock x:Name="NetworkCameraUrlPlaceholderText"
                                               Text="例如：rtsp://账号:密码@192.168.1.64:554/stream"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Row="1"
                                Background="{StaticResource VideoSurfaceBackground}"
                                BorderBrush="{DynamicResource BorderDefault}"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <Grid>
                                <Image x:Name="CameraPreviewImage"
                                       Stretch="Uniform"/>
                                <Button x:Name="RotateCameraButton"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,14,0"
                                        Click="RotateCameraButton_Click"
                                        Style="{StaticResource CameraPreviewOverlayButtonStyle}"
                                        AutomationProperties.Name="旋转摄像头画面 180 度">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource FluentArrowSyncIcon}"
                                              Width="15" Height="15" Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Margin="0,0,6,0"/>
                                        <TextBlock x:Name="RotateCameraButtonText" Text="旋转 180°"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="CameraStatusText"
                                           Text="正在准备摄像头预览..."
                                           Foreground="{StaticResource OverlayTextPrimary}"
                                           Background="{StaticResource OverlaySoft}"
                                           Padding="10,6"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="CameraRecognitionPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- 只留两个选项：标题与副标题去掉，把画面让给识别预览 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="UseCameraRecognitionRadio"
                                         GroupName="CameraRecognitionChoice"
                                         Margin="0"
                                         Checked="CameraRecognitionChoice_Changed"
                                         Style="{StaticResource WizardCardButtonStyle}">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="使用摄像头识别"
                                                   Style="{StaticResource WizardOptionTitleStyle}"/>
                                        <Border Margin="8,0,0,0"
                                                Padding="7,2"
                                                Background="{DynamicResource AccentBlue}"
                                                CornerRadius="5">
                                            <TextBlock Text="推荐"
                                                       Foreground="{StaticResource TextOnAccent}"
                                                       FontSize="11"
                                                       FontWeight="Bold"/>
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="实时测试画面中的面单条码"
                                               Style="{StaticResource WizardOptionHintStyle}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="DisableCameraRecognitionRadio"
                                         Grid.Column="2"
                                         GroupName="CameraRecognitionChoice"
                                         Margin="0"
                                         Checked="CameraRecognitionChoice_Changed"
                                         Style="{StaticResource WizardCardButtonStyle}">
                                <StackPanel>
                                    <TextBlock Text="不使用摄像头识别"
                                               Style="{StaticResource WizardOptionTitleStyle}"/>
                                    <TextBlock Text="改用扫码枪或手动输入面单号"
                                               Style="{StaticResource WizardOptionHintStyle}"/>
                                </StackPanel>
                            </RadioButton>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Border x:Name="CameraRecognitionPreviewPanel"
                                    Background="{StaticResource VideoSurfaceBackground}"
                                    BorderBrush="{DynamicResource BorderDefault}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="CameraRecognitionPreviewImage"
                                           Stretch="Uniform"/>
                                    <Grid x:Name="CameraRecognitionGuide"
                                          Visibility="Collapsed"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False">
                                        <Rectangle x:Name="CameraRecognitionGuideBorder"
                                                   Stroke="{StaticResource CameraGuideStroke}"
                                                   StrokeThickness="3"
                                                   StrokeDashArray="6 3"
                                                   Fill="{StaticResource CameraGuideFill}"
                                                   RadiusX="6"
                                                   RadiusY="6"/>
                                        <Border x:Name="CameraRecognitionStatusBorder"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                Margin="0,10,0,0"
                                                Padding="12,6"
                                                Background="{StaticResource AccentBlue}"
                                                CornerRadius="6">
                                            <TextBlock x:Name="CameraRecognitionStatusText"
                                                       Text="将面单条形码放入框内"
                                                       Foreground="{StaticResource TextOnAccent}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="CameraRecognitionPreviewStatusText"
                                               Text="正在准备摄像头识别预览..."
                                               Foreground="{StaticResource OverlayTextPrimary}"
                                               Background="{StaticResource OverlaySoft}"
                                               Padding="10,6"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="CameraRecognitionSelectedCameraText"
                                               Margin="10"
                                               Padding="8,4"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom"
                                               Foreground="{StaticResource OverlayTextPrimary}"
                                               Background="{StaticResource OverlaySoft}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                            <Border x:Name="CameraRecognitionDisabledPanel"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource ControlBackground}"
                                    BorderBrush="{DynamicResource BorderDefault}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="24">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="已选择不使用摄像头识别"
                                               HorizontalAlignment="Center"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="仍可使用扫码枪或在主页面手动输入面单号"
                                               Margin="0,8,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="RecordingProfilePage" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="检测录制性能"
                                       Style="{StaticResource WizardPageTitleStyle}"/>
                            <TextBlock Text="正在根据这台电脑的编码能力，为已选摄像头推荐稳定的原生分辨率和帧率"
                                       Style="{StaticResource WizardPageHintStyle}"/>

                            <Border Background="{DynamicResource ControlBackground}"
                                    BorderBrush="{DynamicResource BorderDefault}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20">
                                <StackPanel>
                                    <TextBlock x:Name="RecordingProfileStatusText"
                                               Text="正在测试 720P、1080P、2K 和 4K 的实时编码能力，请稍候"
                                               Style="{StaticResource WizardOptionTitleStyle}"
                                               Foreground="{DynamicResource AccentBlue}"/>
                                    <controls:SmoothProgressBar x:Name="RecordingProfileProgress"
                                                                Style="{StaticResource RoundedSmoothProgressBar}"
                                                                Height="6"
                                                                Margin="0,18,0,0"
                                                                IsIndeterminate="True"
                                                                Background="{DynamicResource BorderStrong}"
                                                                Foreground="{DynamicResource AccentBlue}"/>

                                    <Border x:Name="RecordingProfileResultPanel"
                                            Margin="0,20,0,0"
                                            Padding="16"
                                            Visibility="Collapsed"
                                            Background="{DynamicResource PanelBackground}"
                                            BorderBrush="{DynamicResource BorderLight}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock x:Name="RecordingProfileResultTitle"
                                                       Text="已自动选择录制配置"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentGreen}"/>
                                            <TextBlock x:Name="RecordingProfileResultText"
                                                       Margin="0,8,0,0"
                                                       FontSize="15"
                                                       LineHeight="24"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="点击“下一步”继续测试麦克风；完成整个向导后配置才会保存"
                                                       Margin="0,10,0,0"
                                                       Style="{StaticResource WizardOptionHintStyle}"/>
                                            <Button x:Name="RecordingProfileRetryButton"
                                                    Content="重新检测"
                                                    Margin="0,14,0,0"
                                                    HorizontalAlignment="Left"
                                                    Visibility="Collapsed"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="RecordingProfileRetryButton_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="MicPage" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="选择麦克风"
                                       Style="{StaticResource WizardPageTitleStyle}"/>
                            <TextBlock Text="说话时音量条有跳动，就说明麦克风基础配置正常"
                                       Margin="0,8,0,20"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <ComboBox x:Name="MicComboBox"
                                      Height="38"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="MicComboBox_SelectionChanged"
                                      Margin="0,0,0,24"/>
                            <Border Background="{DynamicResource ControlBackground}"
                                    BorderBrush="{DynamicResource BorderDefault}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="18">
                                <StackPanel>
                                    <TextBlock Text="实时音量"
                                               Style="{StaticResource WizardOptionTitleStyle}"
                                               Margin="0,0,0,10"/>
                                    <!-- 电平表每帧都在更新，不用平滑动画（直接给 Value），只共用圆角外观 -->
                                    <controls:SmoothProgressBar x:Name="MicLevelBar"
                                                                Style="{StaticResource RoundedSmoothProgressBar}"
                                                                Height="18"
                                                                Minimum="0"
                                                                Maximum="100"
                                                                Foreground="{DynamicResource AccentBlue}"
                                                                Background="{DynamicResource BorderStrong}"/>
                                    <TextBlock x:Name="MicStatusText"
                                               Text="正在准备麦克风..."
                                               Margin="0,10,0,0"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ScannerPage" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="扫码枪（可选）"
                                       Style="{StaticResource WizardPageTitleStyle}"/>
                            <TextBlock x:Name="ScannerIntroText"
                                       Text="没有扫码枪可直接进入下一步；如需使用，可在这里测试扫码枪"
                                       Style="{StaticResource WizardPageHintStyle}"/>
                            <Border Background="{DynamicResource ControlBackground}"
                                    BorderBrush="{DynamicResource BorderDefault}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,0,0,12">
                                <StackPanel HorizontalAlignment="Center">
                                    <Image x:Name="TestBarcodeImage"
                                           Stretch="None"
                                           SnapsToDevicePixels="True"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TestBarcodeText"
                                               Margin="0,6,0,0"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                            <TextBox x:Name="ScanTestTextBox"
                                     Height="38"
                                     FontSize="16"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     PreviewKeyDown="ScanTestTextBox_PreviewKeyDown"
                                     TextChanged="ScanTestTextBox_TextChanged"/>
                            <Border Margin="0,12,0,0"
                                    Background="{DynamicResource ControlBackground}"
                                    BorderBrush="{DynamicResource BorderDefault}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    MinHeight="138"
                                    Padding="14">
                                <TextBlock x:Name="ScanStatusText"
                                           Text="没有扫码枪可直接进入下一步"
                                           FontSize="13"
                                           LineHeight="20"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="DonePage" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="配置完成"
                                       Style="{StaticResource WizardPageTitleStyle}"/>
                            <TextBlock Text="下面是日常打包流程"
                                       Style="{StaticResource WizardPageHintStyle}"/>
                            <Border Background="{DynamicResource ControlBackground}"
                                    BorderBrush="{DynamicResource BorderDefault}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="18">
                                <TextBlock x:Name="FlowText"
                                           FontSize="16"
                                           LineHeight="30"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </Border>
                            <Border Margin="0,14,0,0"
                                    Background="{DynamicResource ControlBackground}"
                                    BorderBrush="{DynamicResource BorderDefault}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <StackPanel>
                                    <TextBlock Text="局域网查看视频"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="完成向导后会显示手机连接二维码。手机与这台电脑连接同一个局域网，扫码即可打开打包视频和回放页面"
                                               Margin="0,5,0,0"
                                               FontSize="13"
                                               LineHeight="20"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,22,0,0"
                BorderBrush="{DynamicResource BorderStrong}"
                BorderThickness="0,1,0,0"
                Padding="0,16,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SkipButton"
                            Content="跳过"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0"
                            Click="SkipButton_Click"/>
                    <Button x:Name="BackButton"
                            Content="上一步"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0"
                            Click="BackButton_Click"/>
                    <Button x:Name="NextButton"
                            Content="下一步"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="NextButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
