<UserControl x:Class="ExpressPackingMonitoring.UI.ModeTransitionButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ExpressPackingMonitoring.UI"
             MinWidth="130" Height="52">
    <Grid ClipToBounds="True">
        <Border x:Name="BlueLayer" Background="{DynamicResource AccentBlue}" CornerRadius="8"/>
        <Border x:Name="OrangeLayer" Background="{DynamicResource AccentOrange}" CornerRadius="8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Path x:Name="ModeIcon" Data="{StaticResource FluentBoxIcon}" Width="22" Height="22" Stretch="Uniform" Fill="{StaticResource TextOnAccent}" Margin="0,0,8,0"/>
            <TextBlock x:Name="ModeText" Text="发货" FontSize="22" FontWeight="Black" Foreground="{StaticResource TextOnAccent}"/>
        </StackPanel>
        <Button Command="{Binding ToggleModeCommand}" Background="Transparent" BorderThickness="0" Focusable="False" Cursor="Hand"/>
    </Grid>
</UserControl>
