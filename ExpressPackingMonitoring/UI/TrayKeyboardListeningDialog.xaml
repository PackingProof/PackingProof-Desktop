<Window x:Class="ExpressPackingMonitoring.UI.TrayKeyboardListeningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="托盘期间扫码监听"
        SizeToContent="Height"
        Width="430"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}"
        Foreground="{DynamicResource TextPrimary}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="托盘期间继续监听扫码枪？"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"/>

        <TextBlock Grid.Row="1"
                   Margin="0,9,0,0"
                   Text="不监听只会停止扫码枪触发录像，网页服务、主机备份和已有录像仍会继续运行；恢复主界面后自动恢复监听"
                   TextWrapping="Wrap"
                   FontSize="13"
                   LineHeight="20"
                   Foreground="{DynamicResource TextSecondary}"/>

        <CheckBox x:Name="RememberChoiceCheckBox"
                  Grid.Row="2"
                  Margin="0,20,0,0"
                  Content="不再提示，记住我的选择"
                  Foreground="{DynamicResource TextPrimary}"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,24,0,0">
            <Button Content="继续监听"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,10,0"
                    IsDefault="True"
                    Click="ContinueListening_Click"/>
            <Button Content="不监听"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="PauseListening_Click"/>
        </StackPanel>
    </Grid>
</Window>
