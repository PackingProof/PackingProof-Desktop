<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ExpressPackingMonitoring.UI.Controls">

    <!--
        圆角进度条：主界面（指令条码冷却、预录缓冲）与设置页（存储用量）共用同一套外观，
        两端是圆角、填充跟着 Foreground。原来只写在 MainWindow 里，抽出来避免两处各画一套。

        不确定进度（还不知道总大小/总数）时不再用 WPF 默认模板的方角跑马灯，
        改为复用主界面预录缓冲"滚动中"那条流光：整条蓝底 + 一道白色高光扫过（画刷相对平移）。
    -->
    <Style x:Key="RoundedSmoothProgressBar" TargetType="controls:SmoothProgressBar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SmoothProgressBar">
                    <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3.5" ClipToBounds="True">
                        <Grid>
                            <!-- 确定进度：按值填充（宽度由 ProgressBar 自己算） -->
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3.5"/>
                            <!-- 不确定进度：流光扫过整条 -->
                            <!-- 圆角要画在这条矩形本身上：Border 的 ClipToBounds 只按矩形裁，不裁圆角 -->
                            <Rectangle x:Name="IndeterminateShimmer" RadiusX="3.5" RadiusY="3.5" Opacity="0" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform X="-1.4"/>
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="{StaticResource Blue500Color}" Offset="0"/>
                                        <GradientStop Color="{StaticResource Blue500Color}" Offset="0.25"/>
                                        <GradientStop Color="{StaticResource WhiteColor}" Offset="0.5"/>
                                        <GradientStop Color="{StaticResource Blue500Color}" Offset="0.75"/>
                                        <GradientStop Color="{StaticResource Blue500Color}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Opacity" Value="0"/>
                            <Setter TargetName="IndeterminateShimmer" Property="Opacity" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="IndeterminateShimmerStoryboard">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="IndeterminateShimmer"
                                                         Storyboard.TargetProperty="(Shape.Fill).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                         From="-1.4"
                                                         To="1.4"
                                                         Duration="0:0:2.4"
                                                         RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="IndeterminateShimmerStoryboard"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        通用滑杆样式：轨道左边是强调色填充、右边是描边圆角槽，滑块是强调色描边的圆形。
        设置页的容量滑杆和回放页的进度条共用这一套（原来是写在 SettingsWindow 里的私有样式，
        抽出来避免两处各画一套）。各页自己再追加自己的行为（吸附刻度、拖拽提示等）。
    -->
    <Style x:Key="AccentSliderStyle" TargetType="Slider">
        <Setter Property="Height" Value="26"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="{TemplateBinding Height}" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <!-- 用 * 让轨道在整个高度里居中：Auto 会把 18px 的轨道贴到顶部，
                                 看起来整根进度条偏上（现场反馈） -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Track x:Name="PART_Track"
                               Grid.Row="0"
                               Height="18"
                               VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Focusable="False"
                                              IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border x:Name="TrackFill"
                                                    Height="6"
                                                    Background="{DynamicResource AccentBlue}"
                                                    CornerRadius="3"
                                                    VerticalAlignment="Center"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TrackFill" Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="TrackFill" Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Focusable="False"
                                              IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border x:Name="TrackRest"
                                                    Height="6"
                                                    Background="{DynamicResource ControlBackground}"
                                                    BorderBrush="{DynamicResource BorderStrong}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    VerticalAlignment="Center"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TrackRest" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                                    <Setter TargetName="TrackRest" Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="SliderThumb"
                                       Width="16"
                                       Height="16"
                                       Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse x:Name="ThumbGlow"
                                                         Width="22"
                                                         Height="22"
                                                         Fill="{DynamicResource AccentBlue}"
                                                         Opacity="0"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                                                <Ellipse x:Name="ThumbChrome"
                                                         Width="16"
                                                         Height="16"
                                                         Fill="{DynamicResource ControlBackground}"
                                                         Stroke="{DynamicResource AccentBlue}"
                                                         StrokeThickness="2"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbGlow" Property="Opacity" Value="0.12"/>
                                                    <Setter TargetName="ThumbChrome" Property="Fill" Value="{DynamicResource ControlBackground}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbGlow" Property="Opacity" Value="0.2"/>
                                                    <Setter TargetName="ThumbChrome" Property="Fill" Value="{DynamicResource AccentBlue}"/>
                                                    <Setter TargetName="ThumbChrome" Property="Stroke" Value="{DynamicResource AccentBlue}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.58"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
