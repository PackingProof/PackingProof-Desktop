<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <UseRidGraph>true</UseRidGraph>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);NU1701;MVVMTK0045;MSB3277</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin_publish_tmp\**;obj_publish_tmp\**;publish-test\**;publish-size-*\**;bin\Release\publish\**</DefaultItemExcludes>
    
    <!-- 主应用保持目录发布，保留压缩包体积优势；清爽根目录由发布脚本和启动器实现。 -->
    <PublishSingleFile>false</PublishSingleFile>
    <!-- 原生库保持可独立加载，优先保证 OpenCV/SQLite/LibVLC 等运行稳定性。 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 开发构建使用与发布一致的 FFmpeg 基线（Tools/ffmpeg-baseline.json），避免开发/发布能力漂移。 -->
    <FFmpegBaselineVersion>4.4.1</FFmpegBaselineVersion>
    <FFmpegBaselineExecutable>..\package\dependency-cache\ffmpeg\$(FFmpegBaselineVersion)\ffmpeg.exe</FFmpegBaselineExecutable>
    <SatelliteResourceLanguages>en-US;zh-Hans</SatelliteResourceLanguages>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 发布版本默认值：每次发布前手动改为新版本号，发布脚本会用 -p:InformationalVersion 覆盖。 -->
    <Version>0.0.55</Version>
    <GitCommitId Condition="'$(GitCommitId)' == ''">$(SourceRevisionId)</GitCommitId>
  </PropertyGroup>

  <ItemGroup Condition="'$(GitCommitId)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GitCommitId</_Parameter1>
      <_Parameter2>$(GitCommitId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
