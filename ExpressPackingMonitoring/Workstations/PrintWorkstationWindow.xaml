<Window x:Class="ExpressPackingMonitoring.PrintWorkstationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PackingProof 录像文件备份主机"
        Width="880"
        Height="500"
        MinWidth="780"
        MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style x:Key="IconActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
        <Style x:Key="SummaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="104"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="录像文件备份主机"
                               FontSize="28"
                               FontWeight="Black"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Margin="0,7,0,0"
                               Text="集中保存手机/电脑上传的录像，并提供局域网回放和订单联动"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <Button x:Name="SwitchPurposeButton"
                        Grid.Column="1"
                        Height="38"
                        Padding="14,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="SwitchWorkstation_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource FluentArrowSwapIcon}"
                              Width="15" Height="15" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock x:Name="SwitchPurposeButtonText"
                                   Text="切换用途"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="284"/>
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="15"
                                Background="{DynamicResource ControlBackground}">
                            <Path x:Name="StatusIconPath"
                                  Data="{StaticResource FluentDatabaseIcon}"
                                  Width="24" Height="24" Stretch="Uniform"
                                  Fill="{DynamicResource AccentBlue}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="StatusTextBlock"
                                       Text="正在获取电脑名称"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="StatusHintTextBlock"
                                       Margin="0,5,0,0"
                                       Text="正在启动设备备份服务"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <Button x:Name="RepairLanButton"
                                    Height="28"
                                    Margin="0,8,0,0"
                                    Padding="9,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="RepairLan_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource FluentWarningIcon}"
                                          Width="13" Height="13" Stretch="Uniform"
                                          Fill="{DynamicResource AccentOrange}"/>
                                    <TextBlock Text="修复局域网" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <ItemsControl ItemsSource="{Binding MobileBackupDeviceStatuses, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Margin="0,13,0,0"
                                          MaxHeight="76"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <Ellipse Width="8" Height="8" Margin="1,0,7,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource TextMuted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource AccentGreen}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding DisplayText}"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="UserscriptStatusTextBlock"
                                       Margin="0,11,0,0"
                                       Text="尚未配置订单联动"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Button x:Name="ConnectPhoneButton"
                                Grid.Column="0"
                                Style="{StaticResource IconActionButtonStyle}"
                                Click="ConnectPhone_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource FluentWifiIcon}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="连接手机/电脑" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenWebButton"
                                Grid.Column="2"
                                Style="{StaticResource IconActionButtonStyle}"
                                Click="OpenWeb_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource FluentPlayIcon}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="网页回放" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="InstallUserscriptButton"
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource IconActionButtonStyle}"
                                ToolTip="安装或更新快递助手订单联动脚本"
                                Click="InstallTool_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource FluentIntegrationIcon}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock x:Name="InstallUserscriptButtonText"
                                           Text="安装订单联动插件"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SendTestOrderButton"
                                Grid.Row="2"
                                Grid.Column="2"
                                Style="{StaticResource IconActionButtonStyle}"
                                ToolTip="向当前在线的全部录像设备发送测试订单"
                                Click="SendTestOrder_Click"
                                IsEnabled="False">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource FluentBroadcastIcon}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock x:Name="SendTestOrderButtonText"
                                           Text="发送测试订单"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="今日备份"
                                       FontSize="15"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,8,4"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                                <TextBlock x:Name="TodayBackupCountTextBlock"
                                           Text="0"
                                           FontSize="27"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource AccentBlueDark}"/>
                                <TextBlock Text="个"
                                           FontSize="15"
                                           Margin="2,0,0,4"
                                           VerticalAlignment="Bottom"
                                           Foreground="{DynamicResource AccentBlueDark}"/>
                            </StackPanel>
                            <TextBlock Text="累计备份"
                                       FontSize="15"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,8,4"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TotalBackupCountTextBlock"
                                           Text="0"
                                           FontSize="27"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource AccentBlueDark}"/>
                                <TextBlock Text="个"
                                           FontSize="15"
                                           Margin="2,0,0,4"
                                           VerticalAlignment="Bottom"
                                           Foreground="{DynamicResource AccentBlueDark}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="StatisticsButton"
                                Style="{StaticResource SummaryButtonStyle}"
                                Margin="0,0,10,0"
                                Click="OpenStatistics_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource FluentDataIcon}"
                                      Width="17" Height="17" Stretch="Uniform"
                                      Fill="{DynamicResource AccentBlue}"/>
                                <TextBlock Text="数据" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PlaybackButton"
                                Style="{StaticResource SummaryButtonStyle}"
                                Margin="0,0,10,0"
                                Click="OpenPlayback_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource FluentVideoIcon}"
                                      Width="17" Height="17" Stretch="Uniform"
                                      Fill="{DynamicResource AccentBlue}"/>
                                <TextBlock Text="回放" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsButton"
                                Style="{StaticResource SummaryButtonStyle}"
                                Click="OpenSettings_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource FluentSettingsIcon}"
                                      Width="17" Height="17" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="设置" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>
        </ScrollViewer>

        <Border Background="{DynamicResource ToastBackground}"
                CornerRadius="8"
                Padding="24,13"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="620"
                IsHitTestVisible="False"
                Panel.ZIndex="1000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Setter Property="Opacity" Value="0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastState.IsToastVisible, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <Path x:Name="ToastIconPath"
                      Width="18"
                      Height="18"
                      Margin="0,0,9,0"
                      Stretch="Uniform"
                      Fill="White"
                      VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ToastState.ToastMessage, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
