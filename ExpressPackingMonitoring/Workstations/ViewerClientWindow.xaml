<Window x:Class="ExpressPackingMonitoring.ViewerClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PackingProof 查看客户端"
        Width="900"
        Height="680"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="/app.ico"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <Style x:Key="ViewerActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
        <DataTemplate x:Key="HostItemTemplate">
            <Border Margin="2,4"
                    Padding="12"
                    CornerRadius="8"
                    Background="{DynamicResource ControlBackground}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30"
                            Height="30"
                            CornerRadius="8"
                            Background="{DynamicResource ControlBackgroundHover}">
                        <Path Data="{StaticResource FluentStorageIcon}"
                              Width="16"
                              Height="16"
                              Stretch="Uniform"
                              Fill="{DynamicResource AccentBlue}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,12,0">
                        <TextBlock Text="{Binding NodeName, Mode=OneWay}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding Address, Mode=OneWay}"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse Width="7"
                                 Height="7"
                                 Margin="0,0,6,0"
                                 Fill="{DynamicResource AccentGreen}"/>
                        <TextBlock Text="在线"
                                   FontSize="12"
                                   Foreground="{DynamicResource AccentGreen}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="WindowHeadingText" Text="查看客户端" FontSize="28" FontWeight="Black"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="WindowDescriptionText" Text="连接局域网中的 PackingProof 主机，不在本机录制或保存录像"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <Button x:Name="SwitchPurposeButton"
                        Grid.Column="1"
                        Height="38"
                        Padding="14,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="重新选择这台电脑的用途"
                        Click="SwitchPurpose_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource FluentArrowSwapIcon}"
                              Width="15" Height="15" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock Text="切换用途" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border x:Name="HostSummaryBorder"
                    Grid.Row="1"
                    Margin="0,22,0,0"
                    Padding="20"
                    CornerRadius="10"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="HostSummaryLabelColumn" Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="CurrentHostLabel"
                               Text="当前绑定主机"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="HostNameText" Grid.Column="1" Text="尚未绑定"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="HostAddressLabel"
                               Grid.Row="1" Text="主机地址" Margin="0,12,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="HostAddressText" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0"
                               Text="—" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="OnlineStatusLabel"
                               Grid.Row="2" Text="在线状态" Margin="0,12,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="OnlineStatusText" Grid.Row="2" Grid.Column="1" Margin="0,12,0,0"
                               Text="尚未检查" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="CapabilitiesLabel"
                               Grid.Row="3" Text="主机能力" Margin="0,12,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="CapabilitiesText" Grid.Row="3" Grid.Column="1" Margin="0,12,0,0"
                               Text="—" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="RecorderCountLabel"
                               Grid.Row="4" Text="录像设备数量" Margin="0,12,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="RecorderCountText" Grid.Row="4" Grid.Column="1" Margin="0,12,0,0"
                               Text="0" Foreground="{DynamicResource TextPrimary}"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <WrapPanel x:Name="ViewerActionPanel">
                    <Button x:Name="OpenWebButton"
                            Height="38"
                            Padding="12,0"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            ToolTip="在浏览器中打开主机网页回放"
                            Margin="0,0,10,10"
                            Click="OpenWeb_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource FluentPlayIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="打开网页回放" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ViewerChangeHostButton"
                            Style="{StaticResource ViewerActionButtonStyle}"
                            ToolTip="解除当前显示并选择另一台主机"
                            Margin="0,0,10,10"
                            Click="ChangeHost_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource FluentArrowSyncIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="更换主机" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="UserscriptButton"
                            Style="{StaticResource ViewerActionButtonStyle}"
                            ToolTip="安装或更新快递助手订单联动脚本"
                            Margin="0,0,10,10"
                            Click="InstallUserscript_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource FluentIntegrationIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock x:Name="UserscriptButtonText"
                                       Text="安装订单联动"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SendTestOrderButton"
                            Style="{StaticResource ViewerActionButtonStyle}"
                            ToolTip="向当前在线的全部录像设备发送测试订单"
                            IsEnabled="False"
                            Margin="0,0,10,10"
                            Click="SendTestOrder_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource FluentBroadcastIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock x:Name="SendTestOrderButtonText"
                                       Text="发送测试订单"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <TextBlock x:Name="UserscriptStatusText"
                           Text="尚未配置订单联动"
                           Foreground="{DynamicResource TextSecondary}"/>
                <WrapPanel x:Name="BindingBoundActionsPanel"
                           Visibility="Collapsed"
                           HorizontalAlignment="Right">
                    <Button x:Name="BindingChangeHostButton"
                            Style="{StaticResource ViewerActionButtonStyle}"
                            ToolTip="确认后选择另一台保存主机"
                            Margin="0,0,10,0"
                            Click="ChangeHost_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource FluentArrowSyncIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="更换保存主机"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Height="38"
                            Padding="14,0"
                            Click="DeferBinding_Click"
                            Content="完成"/>
                </WrapPanel>
            </StackPanel>

            <Border x:Name="DiscoveryPanel"
                    Grid.Row="3"
                    Margin="0,8,0,0"
                    Padding="20"
                    CornerRadius="10"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock x:Name="DiscoveryHeadingText"
                                       Text="选择要连接的主机"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="SearchStatusText"
                                       Text="正在搜索同一网络中的主机"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                        <Button x:Name="SearchHostsButton"
                                Grid.Column="1"
                                Style="{StaticResource ViewerActionButtonStyle}"
                                ToolTip="重新搜索同一网络中的主机"
                                AutomationProperties.Name="重新搜索主机"
                                Click="SearchHosts_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource FluentSearchIcon}"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="重新搜索"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border x:Name="OfflineHostNotice"
                            Margin="0,16,0,0"
                            Padding="12"
                            CornerRadius="8"
                            Background="{DynamicResource BorderLight}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="上次连接的主机当前离线"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="OfflineHostText"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="HostsList"
                             MinHeight="150"
                             MaxHeight="260"
                             Margin="0,16,0,0"
                             HorizontalContentAlignment="Stretch"
                             ItemTemplate="{StaticResource HostItemTemplate}"
                             AutomationProperties.Name="可连接的主机"
                             SelectionChanged="HostsList_SelectionChanged"
                             MouseDoubleClick="HostsList_MouseDoubleClick">
                    </ListBox>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BindSelectedButton"
                                Height="40"
                                MinWidth="132"
                                Padding="16,0"
                                IsEnabled="False"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                ToolTip="连接列表中选中的主机"
                                AutomationProperties.Name="连接选中的主机"
                                Click="BindSelected_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource FluentCheckIcon}"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock x:Name="BindSelectedButtonText"
                                           Text="连接主机"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="ManualConnectionButton"
                                Grid.Column="1"
                                Height="40"
                                Margin="10,0,0,0"
                                Style="{StaticResource ViewerActionButtonStyle}"
                                ToolTip="手动输入主机地址或完整连接链接"
                                AutomationProperties.Name="手动连接主机"
                                Click="OpenManualConnection_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource FluentLinkIcon}"
                                      Width="15"
                                      Height="15"
                                      Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="手动连接"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="DeferBindingButton"
                                Grid.Column="3"
                                Height="40"
                                Padding="12,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="暂不设置，返回已经运行的电脑录像主界面"
                                AutomationProperties.Name="稍后设置保存主机"
                                Visibility="Collapsed"
                                Click="DeferBinding_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource FluentClockIcon}"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="稍后设置"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
