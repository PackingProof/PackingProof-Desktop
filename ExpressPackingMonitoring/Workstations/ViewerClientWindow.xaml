<Window x:Class="ExpressPackingMonitoring.ViewerClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PackingProof 查看客户端"
        Width="820"
        MinWidth="720"
        MaxHeight="680"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Icon="/app.ico"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <Style x:Key="ViewerActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
        <DataTemplate x:Key="HostItemTemplate">
            <Border Margin="2,4"
                    Padding="12"
                    CornerRadius="8"
                    Background="{DynamicResource ControlBackground}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30"
                            Height="30"
                            CornerRadius="8"
                            Background="{DynamicResource ControlBackgroundHover}">
                        <Path Data="{StaticResource FluentDatabaseIcon}"
                              Width="16"
                              Height="16"
                              Stretch="Uniform"
                              Fill="{DynamicResource AccentBlue}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,12,0">
                        <TextBlock Text="{Binding NodeName, Mode=OneWay}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding Address, Mode=OneWay}"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse Width="7"
                                 Height="7"
                                 Margin="0,0,6,0"
                                 Fill="{DynamicResource AccentGreen}"/>
                        <TextBlock Text="在线"
                                   FontSize="12"
                                   Foreground="{DynamicResource AccentGreen}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="WindowHeadingText" Text="查看客户端" FontSize="28" FontWeight="Black"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="WindowDescriptionText" Text="连接局域网中的 PackingProof 主机，不在本机录制或保存录像"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <Button x:Name="SwitchPurposeButton"
                        Grid.Column="1"
                        Height="38"
                        Padding="14,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="重新选择这台电脑的用途"
                        Click="SwitchPurpose_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource FluentArrowSwapIcon}"
                              Width="15" Height="15" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock Text="切换用途" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border x:Name="HostSummaryBorder"
                    Grid.Row="1"
                    Margin="0,22,0,0"
                    Padding="20"
                    CornerRadius="12"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40"
                                Height="40"
                                CornerRadius="10"
                                Background="{DynamicResource ControlBackgroundHover}">
                            <Path Data="{StaticResource FluentDatabaseIcon}"
                                  Width="20"
                                  Height="20"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource AccentBlue}"/>
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="0,0,18,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="HostNameText"
                                       Text="尚未绑定"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="HostAddressText"
                                       Text="—"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                        <Border Grid.Column="2"
                                Padding="10,5"
                                VerticalAlignment="Top"
                                CornerRadius="12"
                                Background="{DynamicResource BorderLight}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="OnlineStatusIndicator"
                                         Width="7"
                                         Height="7"
                                         Margin="0,0,6,0"
                                         Fill="{DynamicResource AccentGreen}"/>
                                <TextBlock x:Name="OnlineStatusText"
                                           Text="尚未检查"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="ViewerDetailsPanel"
                          Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <Border Padding="14,12"
                                CornerRadius="8"
                                Background="{DynamicResource ControlBackground}">
                            <StackPanel>
                                <TextBlock Text="主机能力"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="CapabilitiesText"
                                           Text="—"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2"
                                Padding="14,12"
                                CornerRadius="8"
                                Background="{DynamicResource ControlBackground}">
                            <StackPanel>
                                <TextBlock Text="录像设备数量"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="RecorderCountText"
                                           Text="0"
                                           Margin="0,5,0,0"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel x:Name="ViewerActionPanel"
                                Margin="0,18,0,0">
                        <WrapPanel>
                            <Button x:Name="OpenWebButton"
                                    Height="38"
                                    Padding="12,0"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    ToolTip="在浏览器中打开主机网页回放"
                                    Margin="0,0,10,0"
                                    Click="OpenWeb_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource FluentPlayIcon}"
                                          Width="16" Height="16" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="打开网页回放" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ViewerChangeHostButton"
                                    Style="{StaticResource ViewerActionButtonStyle}"
                                    ToolTip="解除当前显示并选择另一台保存主机"
                                    Click="ChangeHost_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource FluentDatabaseIcon}"
                                          Width="16" Height="16" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="更换保存主机" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <Border Margin="0,16,0,0"
                                Padding="14"
                                CornerRadius="8"
                                Background="{DynamicResource ControlBackground}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="订单联动"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock x:Name="UserscriptStatusText"
                                               Text="尚未配置订单联动"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1"
                                           VerticalAlignment="Center">
                                    <Button x:Name="UserscriptButton"
                                            Style="{StaticResource ViewerActionButtonStyle}"
                                            ToolTip="安装或更新快递助手订单联动脚本"
                                            Margin="0,0,10,0"
                                            Click="InstallUserscript_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource FluentIntegrationIcon}"
                                                  Width="16" Height="16" Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <TextBlock x:Name="UserscriptButtonText"
                                                       Text="安装订单联动"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="SendTestOrderButton"
                                            Style="{StaticResource ViewerActionButtonStyle}"
                                            ToolTip="向当前在线的全部录像设备发送测试订单"
                                            IsEnabled="False"
                                            Click="SendTestOrder_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource FluentBroadcastIcon}"
                                                  Width="16" Height="16" Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <TextBlock x:Name="SendTestOrderButtonText"
                                                       Text="发送测试订单"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <WrapPanel x:Name="BindingBoundActionsPanel"
                               Margin="0,18,0,0"
                               Visibility="Collapsed"
                               HorizontalAlignment="Right">
                        <Button x:Name="BindingChangeHostButton"
                                Style="{StaticResource ViewerActionButtonStyle}"
                                ToolTip="确认后选择另一台保存主机"
                                Margin="0,0,10,0"
                                Click="ChangeHost_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource FluentDatabaseIcon}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="更换保存主机"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Height="38"
                                Padding="14,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="DeferBinding_Click"
                                Content="完成"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border x:Name="DiscoveryPanel"
                    Grid.Row="1"
                    Margin="0,22,0,0"
                    Padding="20"
                    CornerRadius="12"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock x:Name="DiscoveryHeadingText"
                                       Text="选择保存主机"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="SearchStatusText"
                                       Text="正在搜索同一网络中的保存主机"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                        <Button x:Name="SearchHostsButton"
                                Grid.Column="1"
                                Style="{StaticResource ViewerActionButtonStyle}"
                                ToolTip="重新搜索同一网络中的保存主机"
                                AutomationProperties.Name="重新搜索保存主机"
                                Click="SearchHosts_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource FluentSearchIcon}"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="重新搜索"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border x:Name="SearchProgressBar"
                            Height="4"
                            Margin="0,14,0,0"
                            CornerRadius="2"
                            Background="{DynamicResource BorderLight}"
                            ClipToBounds="True"
                            IsHitTestVisible="False"
                            Visibility="Collapsed"
                            AutomationProperties.Name="正在搜索主机">
                        <Border Width="140"
                                Height="4"
                                HorizontalAlignment="Left"
                                CornerRadius="2"
                                Background="{DynamicResource AccentBlue}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="SearchProgressTransform"
                                                    X="-140"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>

                    <Border x:Name="OfflineHostNotice"
                            Margin="0,16,0,0"
                            Padding="12"
                            CornerRadius="8"
                            Background="{DynamicResource BorderLight}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="上次连接的主机当前离线"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="OfflineHostText"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="HostsList"
                             MaxHeight="244"
                             Margin="0,16,0,0"
                             HorizontalContentAlignment="Stretch"
                             ItemTemplate="{StaticResource HostItemTemplate}"
                             AutomationProperties.Name="可连接的主机"
                             SelectionChanged="HostsList_SelectionChanged"
                             MouseDoubleClick="HostsList_MouseDoubleClick">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <Trigger Property="HasItems" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                    </ListBox>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ManualConnectionButton"
                                    Height="40"
                                    Style="{StaticResource ViewerActionButtonStyle}"
                                    ToolTip="手动输入主机地址或完整连接链接"
                                    AutomationProperties.Name="手动连接主机"
                                    Click="OpenManualConnection_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource FluentLinkIcon}"
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="手动连接"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ScanPhonePairingButton"
                                    Height="40"
                                    Margin="10,0,0,0"
                                    Style="{StaticResource ViewerActionButtonStyle}"
                                    ToolTip="使用本机录像摄像头扫描保存主机连接二维码"
                                    AutomationProperties.Name="扫描保存主机二维码"
                                    Visibility="Collapsed"
                                    Click="ScanPhonePairing_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource FluentCameraIcon}"
                                          Width="16"
                                          Height="16"
                                          Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="摄像头扫码"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Button x:Name="DeferBindingButton"
                                Grid.Column="2"
                                Height="40"
                                Padding="12,0"
                                Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="暂不设置，返回已经运行的电脑录像主界面"
                                AutomationProperties.Name="稍后设置保存主机"
                                Visibility="Collapsed"
                                Click="DeferBinding_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource FluentClockIcon}"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="稍后设置"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BindSelectedButton"
                                Grid.Column="3"
                                Height="40"
                                MinWidth="132"
                                Padding="16,0"
                                IsEnabled="False"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                ToolTip="连接列表中选中的保存主机"
                                AutomationProperties.Name="连接选中的保存主机"
                                Click="BindSelected_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource FluentWifiIcon}"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock x:Name="BindSelectedButtonText"
                                           Text="连接保存主机"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
