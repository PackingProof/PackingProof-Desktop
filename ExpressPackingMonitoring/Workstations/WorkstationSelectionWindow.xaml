<Window x:Class="ExpressPackingMonitoring.WorkstationSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择电脑用途" Height="560" Width="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/app.ico"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <Style x:Key="WorkstationButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BorderLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,26">
            <TextBlock x:Name="StepText"
                       Text="第 1 步，共 2 步"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentBlue}"/>
            <TextBlock x:Name="QuestionText"
                       Text="是否使用这台电脑录像？"
                       Margin="0,8,0,0"
                       FontSize="28"
                       FontWeight="Black"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock x:Name="QuestionHintText"
                       Text="选择是否启用本机摄像头、麦克风、条码识别和扫码枪"
                       Margin="0,8,0,0"
                       FontSize="14"
                       Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <Grid x:Name="RecordingStep" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource WorkstationButtonStyle}"
                    Click="RecordOnThisComputer_Click">
                <StackPanel>
                    <Path Data="{StaticResource FluentVideoIcon}"
                          Width="56"
                          Height="56"
                          Stretch="Uniform"
                          Fill="{DynamicResource AccentBlue}"
                          HorizontalAlignment="Left"/>
                    <TextBlock Text="使用这台电脑录像"
                               Margin="0,20,0,0"
                               FontSize="23"
                               FontWeight="Black"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="启用完整电脑录像能力，包括摄像头、麦克风、面单识别、扫码枪、订单联动和语音提醒"
                               Margin="0,10,0,0"
                               FontSize="14"
                               LineHeight="22"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2"
                    Style="{StaticResource WorkstationButtonStyle}"
                    Click="DoNotRecordOnThisComputer_Click">
                <StackPanel>
                    <Path Data="{StaticResource FluentWifiIcon}"
                          Width="56"
                          Height="56"
                          Stretch="Uniform"
                          Fill="{DynamicResource AccentBlue}"
                          HorizontalAlignment="Left"/>
                    <TextBlock Text="不使用这台电脑录像"
                               Margin="0,20,0,0"
                               FontSize="23"
                               FontWeight="Black"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="不初始化本机摄像头、麦克风或扫码设备；仍可作为保存主机，或只连接其他主机查看"
                               Margin="0,10,0,0"
                               FontSize="14"
                               LineHeight="22"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid x:Name="StorageStep" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource WorkstationButtonStyle}"
                    Click="UseAsStorageHost_Click">
                <StackPanel>
                    <Path Data="{StaticResource FluentPhoneIcon}"
                          Width="56"
                          Height="56"
                          Stretch="Uniform"
                          Fill="{DynamicResource AccentOrange}"
                          HorizontalAlignment="Left"/>
                    <TextBlock Text="作为保存主机"
                               Margin="0,20,0,0"
                               FontSize="23"
                               FontWeight="Black"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="长期保存录像，并接收手机或其他电脑录制工位上传的录像"
                               Margin="0,10,0,0"
                               FontSize="14"
                               LineHeight="22"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2"
                    Style="{StaticResource WorkstationButtonStyle}"
                    Click="DoNotUseAsStorageHost_Click">
                <StackPanel>
                    <Path Data="{StaticResource FluentWifiIcon}"
                          Width="56"
                          Height="56"
                          Stretch="Uniform"
                          Fill="{DynamicResource AccentBlue}"
                          HorizontalAlignment="Left"/>
                    <TextBlock Text="不作为保存主机"
                               Margin="0,20,0,0"
                               FontSize="23"
                               FontWeight="Black"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="不接收其他设备录像；如本机录像，会自动上传到绑定主机，否则仅用于查看"
                               Margin="0,10,0,0"
                               FontSize="14"
                               LineHeight="22"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Button>
        </Grid>

        <Button x:Name="BackButton"
                Grid.Row="2"
                Content="返回上一步"
                Margin="0,20,0,0"
                Padding="18,8"
                HorizontalAlignment="Left"
                Visibility="Collapsed"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="Back_Click"/>
    </Grid>
</Window>
