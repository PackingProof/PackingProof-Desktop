<Window x:Class="ExpressPackingMonitoring.WorkstationSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择电脑用途" Height="690" Width="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/app.ico"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <Style x:Key="WorkstationButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BorderLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,26">
            <TextBlock Text="这台电脑主要用来做什么？"
                       FontSize="28"
                       FontWeight="Black"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="选择后将只启动这个场景需要的设备、存储和网络服务"
                       Margin="0,8,0,0"
                       FontSize="14"
                       Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Button Grid.Column="0" Style="{StaticResource WorkstationButtonStyle}" Click="RecordingHost_Click">
                <StackPanel>
                    <Path Data="{StaticResource FluentVideoIcon}"
                          Width="56"
                          Height="56"
                          Stretch="Uniform"
                          Fill="{DynamicResource AccentBlue}"
                          HorizontalAlignment="Left"/>
                    <TextBlock Text="使用这台电脑录像"
                               Margin="0,20,0,0"
                               FontSize="23"
                               FontWeight="Black"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="使用电脑摄像头和麦克风录制打包过程，优先由摄像头识别面单条码，也可选用扫码枪。本机会成为 PackingProof 主机，也可以接收手机录像"
                               Margin="0,10,0,0"
                               FontSize="14"
                               LineHeight="22"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Style="{StaticResource WorkstationButtonStyle}" Click="RecordingWorkstation_Click">
                <StackPanel>
                    <Path Data="{StaticResource FluentVideoIcon}" Width="56" Height="56" Stretch="Uniform" Fill="{DynamicResource AccentBlue}" HorizontalAlignment="Left"/>
                    <TextBlock Text="使用这台电脑录像，保存到其他主机" Margin="0,20,0,0" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="使用本机摄像头录制打包过程，录像完成后自动上传到局域网中的保存主机。本机只临时保留录像，不接收其他设备上传"
                               Margin="0,10,0,0" FontSize="14" LineHeight="22" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Button>

            <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource WorkstationButtonStyle}" Click="ViewerClient_Click">
                <StackPanel>
                    <Path Data="{StaticResource FluentWifiIcon}"
                          Width="56"
                          Height="56"
                          Stretch="Uniform"
                          Fill="{DynamicResource AccentBlue}"
                          HorizontalAlignment="Left"/>
                    <TextBlock Text="连接已有主机"
                               Margin="0,20,0,0"
                               FontSize="23"
                               FontWeight="Black"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="不在本机录制或保存视频，连接局域网中的 PackingProof 主机查看录像，也可以安装快递助手联动脚本"
                               Margin="0,10,0,0"
                               FontSize="14"
                               LineHeight="22"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Button>

            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource WorkstationButtonStyle}" Click="MobileBackupHost_Click">
                <StackPanel>
                    <Path Data="{StaticResource FluentPhoneIcon}"
                          Width="56"
                          Height="56"
                          Stretch="Uniform"
                          Fill="{DynamicResource AccentOrange}"
                          HorizontalAlignment="Left"/>
                    <TextBlock Text="接收手机录像"
                               Margin="0,20,0,0"
                               FontSize="23"
                               FontWeight="Black"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="不使用电脑摄像头，手机录像备份到这台电脑。本机会成为 PackingProof 主机"
                               Margin="0,10,0,0"
                               FontSize="14"
                               LineHeight="22"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
